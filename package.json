{
  "name": "minimal-games-site",
  "version": "1.0.0",
  "description": "包含10款玩法、题库和完整游戏逻辑的轻量小游戏网站",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "preview": "node scripts/preview-ui.js",
    "test:syntax": "node scripts/check-syntax.js",
    "test:secrets": "node scripts/check-secrets.js",
    "test": "node scripts/security-regression.js && node tests/security-unit.test.js",
    "test:all": "npm run test:syntax && npm run test:secrets && npm test",
    "test:migrations": "node scripts/test-fresh-migrations.js",
    "migrate": "node scripts/run-migrations.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "csrf": "^3.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pinyin": "^4.0.0",
    "pngjs": "^7.0.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "node-fetch": "^2.7.0",
    "nodemon": "^3.0.2",
    "playwright": "^1.62.1",
    "socket.io-client": "^4.8.3"
  },
  "keywords": [
    "games",
    "quiz",
    "slot",
    "scratch",
    "spin",
    "standalone",
    "github-pages"
  ],
  "author": "yigewuguijiang",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
