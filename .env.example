NODE_ENV=production
DB_HOST=database-host
DB_NAME=database-name
DB_USER=database-user
DB_PASS=replace-with-database-password
DB_PORT=5432
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_SSL_SERVERNAME=
DATABASE_STATEMENT_TIMEOUT_MS=15000
DB_POOL_MAX=20
DB_APPLICATION_NAME=minimal-games-site
PAID_ACTION_MAX_IN_FLIGHT=24
PAID_ACTION_MAX_PER_USER=2
PAID_ACTION_MAX_POOL_WAITERS=4
PAID_ACTION_MAX_EVENT_LOOP_LAG_MS=250
SESSION_SECRET=replace-with-64-hex-characters
IDEMPOTENCY_HMAC_SECRET=replace-with-64-hex-characters
RESET_TOKEN_SECRET=replace-with-64-hex-characters
ANALYTICS_TOKEN_SECRET=replace-with-64-hex-characters
DICTATION_TOKEN_SECRET=replace-with-64-hex-characters
LOG_HASH_SECRET=replace-with-64-hex-characters
PUBLIC_ORIGINS=https://example.com
TRUSTED_PROXY_ADDRESSES=127.0.0.1
PORT=3000
WORKER_CREDENTIALS_JSON={"worker-prod-01":{"apiKey":"replace-with-32-byte-worker-api-key","hmacSecret":"replace-with-32-byte-worker-hmac-key"}}
WORKER_CREDENTIAL_ID=worker-prod-01
WORKER_API_KEY=replace-with-32-byte-worker-api-key
WORKER_HMAC_SECRET=replace-with-32-byte-worker-hmac-key
SERVER_URL=https://example.com
# Leave these blank to use the versioned scripts under workers/bilibili.
THREESERVER_SCRIPT=
THREESERVER_PYTHON=python
THREESERVER_BACKEND=http
BILIPK_SCRIPT=
BILIPK_PYTHON=python
BILIPK_CONFIG=C:/path/to/config_gift_only.json
BILI_COOKIE_PATH=C:/Users/user/AppData/Local/MinimalGames/bilibili-cookie.dpapi
ALLOW_PLAINTEXT_BILI_COOKIE=false
PK_MAX_RUNNERS=4
PK_REPORT_SPOOL_DIR=C:/Users/user/AppData/Local/MinimalGames/pk-reports
READINESS_TOKEN=replace-with-32-byte-readiness-token
EXTERNAL_GIFTS_ENABLED=false
PK_EXTERNAL_SEND_ENABLED=false

# Streamer World modules are independently gated and default off.
# Creator Foundation requires both of its first two switches to be true.
STREAMER_WORLD_ENABLED=false
CREATOR_PROFILE_ENABLED=false
QUEST_ENGINE_V2_ENABLED=false
STORY_WORLD_ENABLED=false
LIVE_INTERACTIONS_ENABLED=false
STREAMER_NEW_GAMES_ENABLED=false
STREAMER_REWARD_CATALOG_ENABLED=false
# Optional stable account identity for owner-authored Creator World events.
STREAMER_WORLD_OWNER_USERNAME=
DAILY_GIFT_SPEND_LIMIT=50000
DAILY_USER_GIFT_SPEND_LIMIT=10000
SECURITY_NOTIFICATION_USER=
# Comma-separated staged rollout list. The default is hokboost when omitted.
TASK_CARDS_ENABLED_USERS=hokboost
# Optional; anonymous ipapi.is lookups are limited to 1,000/day.
IPAPI_IS_KEY=
CSRF_TEST_MODE=false
CSRF_AUTO_FILL=false
