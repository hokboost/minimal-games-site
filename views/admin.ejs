<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-redesign page-admin" data-csrf-token="<%= csrfToken %>">
    <%- include('partials/language-switcher') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= lang === 'zh' ? '管理后台' : 'Admin panel' %></h1>
            <div class="nav-links">
                <span><%= lang === 'zh' ? '欢迎，' : 'Welcome, ' %><%= user.username %></span>
                <a href="/admin/analytics"><%= lang === 'zh' ? 'UX 分析' : 'UX analytics' %></a>
                <a href="/">← <%= lang === 'zh' ? '游戏大厅' : 'Games' %></a>
                <a href="/logout"><%= lang === 'zh' ? '退出登录' : 'Log out' %></a>
            </div>
        </div>

        <div class="admin-content">
            
            <div class="cookie-management" style="
                background: linear-gradient(135deg, rgba(255, 152, 0, 0.1), rgba(255, 193, 7, 0.05));
                border: 2px solid #ff9800; border-radius: 15px; padding: 1.5rem; margin-bottom: 2rem;
            ">
                <h2 style="color: #ff9800; margin-bottom: 1rem;"><%= lang === 'zh' ? 'B站 Cookie 管理' : 'Bilibili cookie management' %></h2>
                <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                    <div id="cookieStatus" style="
                        padding: 0.8rem 1.2rem; border-radius: 8px; font-weight: bold;
                        background: rgba(158, 158, 158, 0.2); color: #9e9e9e;
                    "><%= lang === 'zh' ? '状态检查中...' : 'Checking status...' %></div>
                    
                    <button id="check-cookie-status" style="
                        padding: 0.8rem 1.5rem; background: linear-gradient(135deg, #2196f3, #1976d2);
                        color: white; border: none; border-radius: 8px; font-weight: bold;
                        cursor: pointer; transition: all 0.3s ease;
                    "><%= lang === 'zh' ? '检查状态' : 'Check Status' %></button>
                    
                    <button id="refresh-cookies" style="
                        padding: 0.8rem 1.5rem; background: linear-gradient(135deg, #ff9800, #f57c00);
                        color: white; border: none; border-radius: 8px; font-weight: bold;
                        cursor: pointer; transition: all 0.3s ease;
                    "><%= lang === 'zh' ? '刷新 Cookie' : 'Refresh Cookie' %></button>
                </div>
                <div id="cookieDetails" style="margin-top: 1rem; font-size: 0.9rem; color: #ccc;"></div>
            </div>

            
            <div class="room-management" style="
                background: linear-gradient(135deg, rgba(76, 175, 80, 0.1), rgba(129, 199, 132, 0.05));
                border: 2px solid #4caf50; border-radius: 15px; padding: 1.5rem; margin-bottom: 2rem;
            ">
                <h2 style="color: #4caf50; margin-bottom: 1rem;"><%= lang === 'zh' ? '直播间绑定' : 'Live room bindings' %></h2>
                
                
                <div style="
                    background: rgba(255, 255, 255, 0.05); border-radius: 10px; padding: 1rem; margin-bottom: 1rem;
                ">
                    <h3 style="color: #4caf50; margin-bottom: 0.8rem; font-size: 1.1rem;"><%= lang === 'zh' ? '绑定新房间' : 'Bind New Room' %></h3>
                    <form id="bind-room-form" novalidate style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem; align-items: end;">
                        <div>
                            <label style="display: block; margin-bottom: 0.3rem; color: #4caf50; font-size: 0.9rem;"><%= lang === 'zh' ? '用户名:' : 'Username:' %></label>
                            <select id="bindUsername" required
                                style="
                                    width: 100%; padding: 0.8rem; border: 1px solid #555;
                                    border-radius: 8px; background: rgba(255,255,255,0.1);
                                    color: white; font-size: 1rem;
                                "
                            >
                                <% users.forEach(account => { %>
                                    <option value="<%= account.username %>" <%= account.username === userLoggedIn ? 'selected' : '' %>>
                                        <%= account.username %><%= account.username === userLoggedIn ? (lang === 'zh' ? '（自己）' : ' (You)') : '' %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 0.3rem; color: #4caf50; font-size: 0.9rem;"><%= lang === 'zh' ? '直播间号:' : 'Room ID:' %></label>
                            <input type="text" id="bindRoomId" inputmode="numeric" pattern="[0-9]{1,12}" maxlength="12" required autocomplete="off" placeholder="<%= lang === 'zh' ? 'B站直播间号 (例: 3929738)' : 'Bilibili room ID (e.g.: 3929738)' %>"
                                style="
                                    width: 100%; padding: 0.8rem; border: 1px solid #555;
                                    border-radius: 8px; background: rgba(255,255,255,0.1);
                                    color: white; font-size: 1rem;
                                "
                            />
                        </div>
                        <button type="submit" id="bind-room" data-ux-event="admin.bind_room" style="
                            padding: 0.8rem 1.5rem; background: linear-gradient(135deg, #4caf50, #45a049);
                            color: white; border: none; border-radius: 8px; font-weight: bold;
                            cursor: pointer; transition: all 0.3s ease; white-space: nowrap;
                        "><%= lang === 'zh' ? '绑定房间' : 'Bind Room' %></button>
                    </form>
                    <div id="roomBindStatus" role="status" aria-live="polite" hidden style="margin-top: 0.8rem; padding: 0.7rem 0.8rem; border-radius: 6px;"></div>
                </div>

                
                <div style="
                    background: rgba(255, 255, 255, 0.05); border-radius: 10px; padding: 1rem; margin-bottom: 1rem;
                ">
                    <h3 style="color: #f44336; margin-bottom: 0.8rem; font-size: 1.1rem;"><%= lang === 'zh' ? '解除绑定' : 'Unbind' %></h3>
                    <div style="display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: end;">
                        <div>
                            <label style="display: block; margin-bottom: 0.3rem; color: #f44336; font-size: 0.9rem;"><%= lang === 'zh' ? '用户名:' : 'Username:' %></label>
                            <input type="text" id="unbindUsername" placeholder="<%= lang === 'zh' ? '请输入要解绑的用户名' : 'Enter username to unbind' %>"
                                style="
                                    width: 100%; padding: 0.8rem; border: 1px solid #555;
                                    border-radius: 8px; background: rgba(255,255,255,0.1);
                                    color: white; font-size: 1rem;
                                "
                            />
                        </div>
                        <button id="unbind-room" style="
                            padding: 0.8rem 1.5rem; background: linear-gradient(135deg, #f44336, #d32f2f);
                            color: white; border: none; border-radius: 8px; font-weight: bold;
                            cursor: pointer; transition: all 0.3s ease; white-space: nowrap;
                        "><%= lang === 'zh' ? '解除绑定' : 'Unbind' %></button>
                    </div>
                </div>

                
                <div>
                    <h3 style="color: #4caf50; margin-bottom: 0.8rem; font-size: 1.1rem;"><%= lang === 'zh' ? '当前绑定' : 'Current bindings' %></h3>
                    <div id="currentBindings" style="
                        background: rgba(0, 0, 0, 0.3); border-radius: 8px; padding: 1rem;
                        min-height: 100px; color: #ccc;
                    ">
                        <div style="text-align: center; color: #999;">
                            <%= lang === 'zh' ? '正在加载绑定信息...' : 'Loading bindings...' %>
                        </div>
                    </div>
                    <button id="load-room-bindings" style="
                        margin-top: 0.8rem; padding: 0.6rem 1.2rem; 
                        background: linear-gradient(135deg, #2196f3, #1976d2);
                        color: white; border: none; border-radius: 6px; font-weight: bold;
                        cursor: pointer; transition: all 0.3s ease;
                    "><%= lang === 'zh' ? '刷新列表' : 'Refresh List' %></button>
                </div>
            </div>

            <table class="users-table">
                <thead>
                    <tr>
                        <th><%= lang === 'zh' ? '用户名' : 'Username' %></th>
                        <th><%= lang === 'zh' ? '积分余额' : 'Point Balance' %></th>
                        <th><%= lang === 'zh' ? '操作' : 'Actions' %></th>
                        <th><%= lang === 'zh' ? '密码管理' : 'Password' %></th>
                        <th><%= lang === 'zh' ? '账号管理' : 'Account' %></th>
                        <th><%= lang === 'zh' ? '登录状态' : 'Status' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td>
                                <a class="user-link" href="/admin/users/<%= encodeURIComponent(user.username) %>/records">
                                    <%= user.username %>
                                </a>
                            </td>
                            <td class="balance">
                                <span class="balance-display"><%= user.balance || 0 %> 积分</span>
                                <button class="edit-balance-btn" data-action="edit-balance" data-username="<%= user.username %>" data-balance="<%= user.balance || 0 %>">
                                    <%= lang === 'zh' ? '修改' : 'Edit' %>
                                </button>
                            </td>
                            <td>
                                <button class="btn-add" data-action="add-point" data-username="<%= user.username %>"><%= lang === 'zh' ? '加积分' : 'Add points' %></button>
                                <% if (user.authorized) { %>
                                    <button class="btn-unauthorize" data-action="unauthorize" data-username="<%= user.username %>"><%= lang === 'zh' ? '取消授权' : 'Revoke' %></button>
                                <% } else { %>
                                    <button class="btn-authorize" data-action="authorize" data-username="<%= user.username %>"><%= lang === 'zh' ? '授权' : 'Authorize' %></button>
                                <% } %>
                            </td>
                            <td>
                                <% if (user.username === userLoggedIn) { %>
                                    <button class="btn-self" id="change-self-password"><%= lang === 'zh' ? '修改密码' : 'Change password' %></button>
                                <% } else { %>
                                    <button class="btn-reset" data-action="reset-password" data-username="<%= user.username %>"><%= lang === 'zh' ? '重置密码' : 'Reset password' %></button>
                                <% } %>
                            </td>
                            <td>
                                <% if (user.username === userLoggedIn) { %>
                                    <span class="self-indicator"><%= lang === 'zh' ? '自己' : 'You' %></span>
                                <% } else { %>
                                    <button class="btn-delete" data-action="delete-account" data-username="<%= user.username %>"><%= lang === 'zh' ? '注销账号' : 'Delete account' %></button>
                                <% } %>
                            </td>
                            <td>
                                <% if (user.is_admin) { %>
                                    <span class="status-admin"><%= lang === 'zh' ? '管理员' : 'Admin' %></span>
                                <% } else if (user.is_locked) { %>
                                    <div class="status-locked">
                                        <%= lang === 'zh' ? '已锁定' : 'Locked' %><br>
                                        <small><%= lang === 'zh' ? '剩余' : 'Remaining' %> <%= user.lock_minutes %> <%= lang === 'zh' ? '分钟' : 'min' %></small><br>
                                        <small><%= lang === 'zh' ? '失败次数' : 'Failures' %>: <%= user.login_failures %></small><br>
                                        <button class="btn-unlock" data-action="unlock" data-username="<%= user.username %>"><%= lang === 'zh' ? '解锁' : 'Unlock' %></button>
                                    </div>
                                <% } else if (user.login_failures > 0) { %>
                                    <div class="status-warning">
                                        <%= lang === 'zh' ? '警告' : 'Warning' %><br>
                                        <small><%= lang === 'zh' ? '失败次数' : 'Failures' %>: <%= user.login_failures %></small><br>
                                        <button class="btn-clear" data-action="clear-failures" data-username="<%= user.username %>"><%= lang === 'zh' ? '清除' : 'Clear' %></button>
                                    </div>
                                <% } else { %>
                                    <span class="status-normal"><%= lang === 'zh' ? '正常' : 'Normal' %></span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <div class="recent-records">
                <h2><%= lang === 'zh' ? '最近游戏记录' : 'Recent game records' %></h2>
                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th><%= lang === 'zh' ? '用户名' : 'Username' %></th>
                                <th>Quiz</th>
                                <th>Slot</th>
                                <th>Scratch</th>
                                <th>Wish</th>
                                <th>Stone</th>
                                <th>Flip</th>
                                <th>Duel</th>
                                <th>Spin</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td><%= user.username %></td>
                                    <td><%= latestRecords?.[user.username]?.quiz || '-' %></td>
                                    <td><%= latestRecords?.[user.username]?.slot || '-' %></td>
                                    <td><%= latestRecords?.[user.username]?.scratch || '-' %></td>
                                    <td><%= latestRecords?.[user.username]?.wish || '-' %></td>
                                    <td><%= latestRecords?.[user.username]?.stone || '-' %></td>
                                    <td><%= latestRecords?.[user.username]?.flip || '-' %></td>
                                    <td><%= latestRecords?.[user.username]?.duel || '-' %></td>
                                    <td><%= latestRecords?.[user.username]?.spin || '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dictation-records">
                <h2><%= lang === 'zh' ? '听写提交记录' : 'Dictation submissions' %></h2>
                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th><%= lang === 'zh' ? '提交时间' : 'Submitted At' %></th>
                                <th><%= lang === 'zh' ? '用户名' : 'Username' %></th>
                                <th><%= lang === 'zh' ? '关卡' : 'Level' %></th>
                                <th><%= lang === 'zh' ? '套题' : 'Set' %></th>
                                <th><%= lang === 'zh' ? '题号' : 'Word ID' %></th>
                                <th><%= lang === 'zh' ? '词语' : 'Word' %></th>
                                <th><%= lang === 'zh' ? '读音' : 'Pronunciation' %></th>
                                <th><%= lang === 'zh' ? '解释' : 'Definition' %></th>
                                <th><%= lang === 'zh' ? '用户输入' : 'User Input' %></th>
                                <th><%= lang === 'zh' ? '手写图' : 'Handwriting' %></th>
                                <th><%= lang === 'zh' ? '状态' : 'Status' %></th>
                                <th><%= lang === 'zh' ? '审核' : 'Review' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (dictationSubmissions && dictationSubmissions.length) { %>
                                <% dictationSubmissions.forEach(row => { %>
                                    <tr>
                                        <td><%= row.submitted_at %></td>
                                        <td><%= row.username || '-' %></td>
                                        <td><%= row.level || '-' %></td>
                                        <td><%= row.set_id || '-' %></td>
                                        <td><%= row.word_id || '-' %></td>
                                        <td><%= row.word || '-' %></td>
                                        <td><%= row.pronunciation || '-' %></td>
                                        <td><%= row.definition || '-' %></td>
                                        <td><%= row.user_input || '-' %></td>
                                        <td>
                                            <% if (row.image_path) { %>
                                                <a href="<%= row.image_path %>" target="_blank" rel="noopener">
                                                    <img src="<%= row.image_path %>" alt="dictation" style="width: 64px; height: 64px; object-fit: contain; background: #0b151b; border-radius: 6px; border: 1px solid rgba(255,255,255,0.15);">
                                                </a>
                                            <% } else { %>
                                                <%= lang === 'zh' ? '文本提交' : 'Text submission' %>
                                            <% } %>
                                        </td>
                                        <td><%= row.status || '-' %></td>
                                        <td>
                                            <div class="dictation-review-actions">
                                                <button class="btn-approve" data-action="dictation-mark" data-id="<%= row.id %>" data-status="correct">
                                                    <%= lang === 'zh' ? '正确' : 'Correct' %>
                                                </button>
                                                <button class="btn-reject" data-action="dictation-mark" data-id="<%= row.id %>" data-status="wrong">
                                                    <%= lang === 'zh' ? '错误' : 'Wrong' %>
                                                </button>
                                                <button class="btn-warn" data-action="dictation-mark" data-id="<%= row.id %>" data-status="rewrite">
                                                    <%= lang === 'zh' ? '请重写' : 'Rewrite' %>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="12" style="text-align: center; color: #aaa;">
                                        <%= lang === 'zh' ? '暂无听写提交记录' : 'No dictation submissions yet' %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dictation-latest">
                <h2><%= lang === 'zh' ? '听写套题最近结果' : 'Latest dictation results' %></h2>
                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th><%= lang === 'zh' ? '用户名' : 'Username' %></th>
                                <th><%= lang === 'zh' ? '套题' : 'Set' %></th>
                                <th><%= lang === 'zh' ? '结果' : 'Result' %></th>
                                <th><%= lang === 'zh' ? '开始时间' : 'Started At' %></th>
                                <th><%= lang === 'zh' ? '结束时间' : 'Ended At' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (dictationLatest && dictationLatest.length) { %>
                                <% dictationLatest.forEach(row => { %>
                                    <tr>
                                        <td><%= row.username %></td>
                                        <td><%= row.set_id %></td>
                                        <td><%= row.result %></td>
                                        <td><%= row.started_at || '-' %></td>
                                        <td><%= row.ended_at || '-' %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" style="text-align: center; color: #aaa;">
                                        <%= lang === 'zh' ? '暂无记录' : 'No records' %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <style>
    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.8);
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        color: #fff;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #00c853;
    }

    .admin-header h1 {
        margin: 0;
        color: #00c853;
    }

    .nav-links {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .nav-links span {
        color: #ccc;
        font-weight: bold;
    }

    .nav-links a {
        color: #fff;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }

    .nav-links a:hover {
        background: rgba(0, 200, 83, 0.2);
        transform: translateY(-2px);
    }

    .admin-content {
        overflow-x: auto;
    }

    .recent-records {
        margin-top: 2rem;
    }

    .recent-records h2 {
        margin-bottom: 0.8rem;
        color: #ffeb3b;
    }

    .dictation-records {
        margin-top: 2rem;
    }

    .dictation-records h2 {
        margin-bottom: 0.8rem;
        color: #4dd0e1;
    }

    .dictation-latest {
        margin-top: 2rem;
    }

    .dictation-latest h2 {
        margin-bottom: 0.8rem;
        color: #81ecec;
    }

    .records-table-wrap {
        overflow-x: auto;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        padding: 0.5rem;
    }

    .records-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
        background: rgba(255, 255, 255, 0.03);
    }

    .records-table th {
        background: linear-gradient(135deg, #ffb300, #f57c00);
        color: #fff;
        padding: 0.7rem 0.5rem;
        text-align: left;
        font-weight: bold;
        font-size: 0.85rem;
    }

    .dictation-review-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .records-table td {
        padding: 0.6rem 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 0.85rem;
        color: #ddd;
        white-space: nowrap;
    }

    .records-table tr:hover {
        background: rgba(255, 255, 255, 0.04);
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        overflow: hidden;
    }

    .users-table th {
        background: linear-gradient(135deg, #00c853, #00bfa5);
        color: #fff;
        padding: 0.7rem 0.4rem;
        text-align: left;
        font-weight: bold;
        font-size: 0.85rem;
    }

    .users-table td {
        padding: 0.7rem 0.4rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        vertical-align: top;
        font-size: 0.85rem;
    }


    .users-table tr:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .user-link {
        color: #ffeb3b;
        text-decoration: none;
        font-weight: bold;
    }

    .user-link:hover {
        text-decoration: underline;
    }

    .spins {
        color: #e91e63;
        font-weight: bold;
        font-size: 1.1rem;
    }

    /* 按钮样式 */
    .users-table button {
        padding: 0.3rem 0.6rem;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
        margin: 0.1rem;
        transition: all 0.3s ease;
        font-weight: bold;
    }

    .btn-add {
        background: #4caf50;
        color: white;
    }

    .btn-add:hover {
        background: #45a049;
        transform: translateY(-1px);
    }

    .btn-authorize {
        background: #2196f3;
        color: white;
    }

    .btn-authorize:hover {
        background: #1976d2;
        transform: translateY(-1px);
    }

    .btn-unauthorize {
        background: #ff9800;
        color: white;
    }

    .btn-unauthorize:hover {
        background: #f57c00;
        transform: translateY(-1px);
    }

    .btn-reset {
        background: #ff6b6b;
        color: white;
    }

    .btn-reset:hover {
        background: #ff5252;
        transform: translateY(-1px);
    }

    .btn-delete {
        background: #dc3545;
        color: white;
    }

    .btn-delete:hover {
        background: #c82333;
        transform: translateY(-1px);
    }

    .balance {
        display: flex;
        align-items: center;
