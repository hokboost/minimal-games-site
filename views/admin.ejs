<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-redesign page-admin" data-csrf-token="<%= csrfToken %>">
    <%- include('partials/language-switcher') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= lang === 'zh' ? '管理后台' : 'Admin panel' %></h1>
            <div class="nav-links">
                <span><%= lang === 'zh' ? '欢迎，' : 'Welcome, ' %><%= user.username %></span>
                <a href="/admin/analytics"><%= lang === 'zh' ? 'UX 分析' : 'UX analytics' %></a>
                <a href="/">← <%= lang === 'zh' ? '游戏大厅' : 'Games' %></a>
                <form method="POST" action="/logout" class="logout-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="logout-link-button"><%= lang === 'zh' ? '退出登录' : 'Log out' %></button>
                </form>
            </div>
        </div>

        <div class="admin-content">
            <div class="cookie-management">
                <h2><%= lang === 'zh' ? 'B站 Cookie 管理' : 'Bilibili cookie management' %></h2>
                <div class="admin-cookie-toolbar">
                    <div id="cookieStatus" class="cookie-status cookie-status-neutral"><%= lang === 'zh' ? '状态检查中...' : 'Checking status...' %></div>
                    
                    <button id="check-cookie-status"><%= lang === 'zh' ? '检查状态' : 'Check Status' %></button>
                    
                </div>
                <div id="cookieDetails" class="cookie-details"></div>
            </div>

            
            <div class="room-management">
                <h2><%= lang === 'zh' ? '直播间绑定' : 'Live room bindings' %></h2>
                
                
                <div class="room-management-panel">
                    <h3 class="admin-section-heading"><%= lang === 'zh' ? '绑定新房间' : 'Bind New Room' %></h3>
                    <form id="bind-room-form" class="admin-room-grid admin-room-grid-bind" novalidate>
                        <div>
                            <label class="admin-field-label" for="bindUsername"><%= lang === 'zh' ? '用户名:' : 'Username:' %></label>
                            <select id="bindUsername" required>
                                <% users.forEach(account => { %>
                                    <option value="<%= account.username %>" <%= account.username === userLoggedIn ? 'selected' : '' %>>
                                        <%= account.username %><%= account.username === userLoggedIn ? (lang === 'zh' ? '（自己）' : ' (You)') : '' %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="admin-field-label" for="bindRoomId"><%= lang === 'zh' ? '直播间号:' : 'Room ID:' %></label>
                            <input type="text" id="bindRoomId" inputmode="numeric" pattern="[0-9]{1,12}" maxlength="12" required autocomplete="off" placeholder="<%= lang === 'zh' ? 'B站直播间号 (例: 3929738)' : 'Bilibili room ID (e.g.: 3929738)' %>"
                            />
                        </div>
                        <button type="submit" id="bind-room" data-ux-event="admin.bind_room"><%= lang === 'zh' ? '绑定房间' : 'Bind Room' %></button>
                    </form>
                    <div id="roomBindStatus" class="room-bind-status room-bind-status-info" role="status" aria-live="polite" hidden></div>
                </div>

                
                <div class="room-management-panel">
                    <h3 class="admin-section-heading admin-section-heading-danger"><%= lang === 'zh' ? '解除绑定' : 'Unbind' %></h3>
                    <div class="admin-room-grid admin-room-grid-unbind">
                        <div>
                            <label class="admin-field-label admin-field-label-danger" for="unbindUsername"><%= lang === 'zh' ? '用户名:' : 'Username:' %></label>
                            <input type="text" id="unbindUsername" placeholder="<%= lang === 'zh' ? '请输入要解绑的用户名' : 'Enter username to unbind' %>">
                        </div>
                        <button id="unbind-room"><%= lang === 'zh' ? '解除绑定' : 'Unbind' %></button>
                    </div>
                </div>

                
                <div>
                    <h3 class="admin-section-heading"><%= lang === 'zh' ? '当前绑定' : 'Current bindings' %></h3>
                    <div id="currentBindings">
                        <div class="binding-empty">
                            <%= lang === 'zh' ? '正在加载绑定信息...' : 'Loading bindings...' %>
                        </div>
                    </div>
                    <button id="load-room-bindings"><%= lang === 'zh' ? '刷新列表' : 'Refresh List' %></button>
                </div>
            </div>

            <table class="users-table">
                <thead>
                    <tr>
                        <th><%= lang === 'zh' ? '用户名' : 'Username' %></th>
                        <th><%= lang === 'zh' ? '积分余额' : 'Point Balance' %></th>
                        <th><%= lang === 'zh' ? '操作' : 'Actions' %></th>
                        <th><%= lang === 'zh' ? '密码管理' : 'Password' %></th>
                        <th><%= lang === 'zh' ? '账号管理' : 'Account' %></th>
                        <th><%= lang === 'zh' ? '登录状态' : 'Status' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td>
                                <a class="user-link" href="/admin/users/<%= encodeURIComponent(user.username) %>/records">
                                    <%= user.username %>
                                </a>
                            </td>
                            <td class="balance">
                                <span class="balance-display"><%= user.balance || 0 %> 积分</span>
                                <button class="edit-balance-btn" data-action="edit-balance" data-username="<%= user.username %>" data-balance="<%= user.balance || 0 %>">
                                    <%= lang === 'zh' ? '修改' : 'Edit' %>
                                </button>
                            </td>
                            <td>
                                <button class="btn-add" data-action="add-point" data-username="<%= user.username %>"><%= lang === 'zh' ? '加积分' : 'Add points' %></button>
                                <% if (user.authorized) { %>
                                    <button class="btn-unauthorize" data-action="unauthorize" data-username="<%= user.username %>"><%= lang === 'zh' ? '取消授权' : 'Revoke' %></button>
                                <% } else { %>
                                    <button class="btn-authorize" data-action="authorize" data-username="<%= user.username %>"><%= lang === 'zh' ? '授权' : 'Authorize' %></button>
                                <% } %>
                            </td>
                            <td>
                                <% if (user.username === userLoggedIn) { %>
                                    <button class="btn-self" id="change-self-password"><%= lang === 'zh' ? '修改密码' : 'Change password' %></button>
                                <% } else { %>
                                    <button class="btn-reset" data-action="reset-password" data-username="<%= user.username %>"><%= lang === 'zh' ? '重置密码' : 'Reset password' %></button>
                                <% } %>
                            </td>
                            <td>
                                <% if (user.username === userLoggedIn) { %>
                                    <span class="self-indicator"><%= lang === 'zh' ? '自己' : 'You' %></span>
                                <% } else { %>
                                    <button class="btn-delete" data-action="delete-account" data-username="<%= user.username %>"><%= lang === 'zh' ? '注销账号' : 'Delete account' %></button>
                                    <% if (user.account_locked) { %>
                                        <button class="btn-unlock" data-action="permanent-unlock" data-username="<%= user.username %>"><%= lang === 'zh' ? '解除永久锁定' : 'Remove lock' %></button>
                                        <small class="status-locked"><%= user.account_lock_reason %></small>
                                    <% } else { %>
                                        <button class="btn-delete" data-action="permanent-lock" data-username="<%= user.username %>"><%= lang === 'zh' ? '锁定账号' : 'Lock account' %></button>
                                    <% } %>
                                <% } %>
                            </td>
                            <td>
                                <% if (user.is_admin) { %>
                                    <span class="status-admin"><%= lang === 'zh' ? '管理员' : 'Admin' %></span>
                                <% } else if (user.is_locked) { %>
                                    <div class="status-locked">
                                        <%= lang === 'zh' ? '已锁定' : 'Locked' %><br>
                                        <small><%= lang === 'zh' ? '剩余' : 'Remaining' %> <%= user.lock_minutes %> <%= lang === 'zh' ? '分钟' : 'min' %></small><br>
                                        <small><%= lang === 'zh' ? '失败次数' : 'Failures' %>: <%= user.login_failures %></small><br>
                                        <button class="btn-unlock" data-action="unlock" data-username="<%= user.username %>"><%= lang === 'zh' ? '解锁' : 'Unlock' %></button>
                                    </div>
                                <% } else if (user.login_failures > 0) { %>
                                    <div class="status-warning">
                                        <%= lang === 'zh' ? '警告' : 'Warning' %><br>
                                        <small><%= lang === 'zh' ? '失败次数' : 'Failures' %>: <%= user.login_failures %></small><br>
                                        <button class="btn-clear" data-action="clear-failures" data-username="<%= user.username %>"><%= lang === 'zh' ? '清除' : 'Clear' %></button>
                                    </div>
                                <% } else { %>
                                    <span class="status-normal"><%= lang === 'zh' ? '正常' : 'Normal' %></span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            <% if (nextUsersCursor) { %>
                <p class="admin-pagination">
                    <a href="/admin?after=<%= encodeURIComponent(nextUsersCursor) %>">
                        <%= lang === 'zh' ? '下一页用户' : 'Next users' %> →
                    </a>
                </p>
            <% } %>

            <section class="admin-task-management" aria-labelledby="admin-task-title">
                <h2 id="admin-task-title"><%= lang === 'zh' ? '任务卡管理' : 'Task card management' %></h2>
                <div class="admin-task-grid">
                    <form id="assign-task-offers-form" class="admin-task-panel">
                        <h3><%= lang === 'zh' ? '分配三张候选卡' : 'Assign three card choices' %></h3>
                        <label><%= lang === 'zh' ? '测试用户名' : 'Test username' %>
                            <input name="username" value="hokboost" required>
                        </label>
                        <div id="task-template-options"><%= lang === 'zh' ? '正在加载模板…' : 'Loading templates…' %></div>
                        <button type="submit"><%= lang === 'zh' ? '分配选中的三张' : 'Assign selected three' %></button>
                    </form>
                    <form id="assign-event-task-form" class="admin-task-panel">
                        <h3><%= lang === 'zh' ? '直接分配限时活动' : 'Assign limited-time event' %></h3>
                        <label><%= lang === 'zh' ? '用户名' : 'Username' %><input name="username" required></label>
                        <label><%= lang === 'zh' ? '任务标题' : 'Title' %><input name="title" maxlength="240" required></label>
                        <label><%= lang === 'zh' ? '任务说明' : 'Description' %><textarea name="description" maxlength="2000" required></textarea></label>
                        <label><%= lang === 'zh' ? '奖励积分' : 'Reward points' %><input name="rewardPoints" type="number" min="1" max="100000000" required></label>
                        <label><%= lang === 'zh' ? '期限（天）' : 'Days' %><input name="days" type="number" min="1" max="90" value="7" required></label>
                        <button type="submit"><%= lang === 'zh' ? '立即分配并开始倒计时' : 'Assign and start countdown' %></button>
                    </form>
                </div>
                <div class="admin-task-panel">
                    <h3><%= lang === 'zh' ? '等待审核' : 'Pending review' %></h3>
                    <div id="pending-task-reviews"><%= lang === 'zh' ? '正在加载…' : 'Loading…' %></div>
                </div>
            </section>

            <section class="admin-task-management" aria-labelledby="ip-intel-title">
                <h2 id="ip-intel-title"><%= lang === 'zh' ? 'IP / VPN 查询' : 'IP / VPN lookup' %></h2>
                <form id="ip-intel-form" class="admin-task-panel">
                    <label><%= lang === 'zh' ? 'IP 地址' : 'IP address' %><input name="ip" placeholder="142.122.111.63" required></label>
                    <button type="submit"><%= lang === 'zh' ? '查看风险与 VPN 情报' : 'Check risk and VPN intelligence' %></button>
                    <small><%= lang === 'zh' ? '结果仅供后台参考，不会自动锁号或封禁。' : 'Display only; this never automatically locks or bans an account.' %></small>
                </form>
                <div id="ip-intel-result" class="admin-task-panel" hidden></div>
            </section>

            <div class="recent-records">
                <h2><%= lang === 'zh' ? '最近游戏记录' : 'Recent game records' %></h2>
                <% const recentGameDescriptors = typeof recordGames !== 'undefined'
                    ? recordGames
                    : (typeof gameCatalog !== 'undefined' ? gameCatalog.filter(game => game.recordView) : []); %>
                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th><%= lang === 'zh' ? '用户名' : 'Username' %></th>
                                <% recentGameDescriptors.forEach(game => { %>
                                    <th><%= lang === 'zh' ? game.titleZh : game.titleEn %></th>
                                <% }) %>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td><%= user.username %></td>
                                    <% recentGameDescriptors.forEach(game => {
                                        const recentRecord = latestRecords?.[user.username]?.[game.recordView];
                                        const recentText = typeof recentRecord === 'string'
                                            ? recentRecord
                                            : recentRecord?.[lang === 'zh' ? 'zh' : 'en'];
                                    %>
                                        <td><%= recentText || '-' %></td>
                                    <% }) %>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dictation-records">
                <h2><%= lang === 'zh' ? '听写提交记录' : 'Dictation submissions' %></h2>
                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th><%= lang === 'zh' ? '提交时间' : 'Submitted At' %></th>
                                <th><%= lang === 'zh' ? '用户名' : 'Username' %></th>
                                <th><%= lang === 'zh' ? '关卡' : 'Level' %></th>
                                <th><%= lang === 'zh' ? '套题' : 'Set' %></th>
                                <th><%= lang === 'zh' ? '题号' : 'Word ID' %></th>
                                <th><%= lang === 'zh' ? '词语' : 'Word' %></th>
                                <th><%= lang === 'zh' ? '读音' : 'Pronunciation' %></th>
                                <th><%= lang === 'zh' ? '解释' : 'Definition' %></th>
                                <th><%= lang === 'zh' ? '用户输入' : 'User Input' %></th>
                                <th><%= lang === 'zh' ? '手写图' : 'Handwriting' %></th>
                                <th><%= lang === 'zh' ? '状态' : 'Status' %></th>
                                <th><%= lang === 'zh' ? '审核' : 'Review' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (dictationSubmissions && dictationSubmissions.length) { %>
                                <% dictationSubmissions.forEach(row => { %>
                                    <tr>
                                        <td><%= row.submitted_at %></td>
                                        <td><%= row.username || '-' %></td>
                                        <td><%= row.level || '-' %></td>
                                        <td><%= row.set_id || '-' %></td>
                                        <td><%= row.word_id || '-' %></td>
                                        <td><%= row.word || '-' %></td>
                                        <td><%= row.pronunciation || '-' %></td>
                                        <td><%= row.definition || '-' %></td>
                                        <td><%= row.user_input || '-' %></td>
                                        <td>
                                            <% if (row.image_path) { %>
                                                <a href="/api/dictation/submissions/<%= row.id %>/image" target="_blank" rel="noopener">
                                                    <img class="dictation-thumbnail" src="/api/dictation/submissions/<%= row.id %>/image" alt="dictation">
                                                </a>
                                            <% } else { %>
                                                <%= lang === 'zh' ? '文本提交' : 'Text submission' %>
                                            <% } %>
                                        </td>
                                        <td><%= row.status || '-' %></td>
                                        <td>
                                            <div class="dictation-review-actions">
                                                <button class="btn-approve" data-action="dictation-mark" data-id="<%= row.id %>" data-status="correct">
                                                    <%= lang === 'zh' ? '正确' : 'Correct' %>
                                                </button>
                                                <button class="btn-reject" data-action="dictation-mark" data-id="<%= row.id %>" data-status="wrong">
                                                    <%= lang === 'zh' ? '错误' : 'Wrong' %>
                                                </button>
                                                <button class="btn-warn" data-action="dictation-mark" data-id="<%= row.id %>" data-status="rewrite">
                                                    <%= lang === 'zh' ? '请重写' : 'Rewrite' %>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="12" class="table-empty">
                                        <%= lang === 'zh' ? '暂无听写提交记录' : 'No dictation submissions yet' %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dictation-latest">
                <h2><%= lang === 'zh' ? '听写套题最近结果' : 'Latest dictation results' %></h2>
                <div class="records-table-wrap">
                    <table class="records-table">
                        <thead>
                            <tr>
                                <th><%= lang === 'zh' ? '用户名' : 'Username' %></th>
                                <th><%= lang === 'zh' ? '套题' : 'Set' %></th>
                                <th><%= lang === 'zh' ? '结果' : 'Result' %></th>
                                <th><%= lang === 'zh' ? '开始时间' : 'Started At' %></th>
                                <th><%= lang === 'zh' ? '结束时间' : 'Ended At' %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (dictationLatest && dictationLatest.length) { %>
                                <% dictationLatest.forEach(row => { %>
                                    <tr>
                                        <td><%= row.username %></td>
                                        <td><%= row.set_id %></td>
                                        <td><%= row.result %></td>
                                        <td><%= row.started_at || '-' %></td>
                                        <td><%= row.ended_at || '-' %></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="table-empty">
                                        <%= lang === 'zh' ? '暂无记录' : 'No records' %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <dialog id="admin-reauth-dialog" class="admin-reauth-dialog" aria-labelledby="admin-reauth-title">
        <form id="admin-reauth-form" class="admin-reauth-form">
            <h2 id="admin-reauth-title"><%= lang === 'zh' ? '验证管理员身份' : 'Verify administrator' %></h2>
            <p><%= lang === 'zh'
                ? '为了保护高风险操作，请输入当前管理员密码。验证后会自动继续刚才的操作。'
                : 'Enter the current administrator password to continue this sensitive action.' %></p>
            <label for="admin-reauth-password"><%= lang === 'zh' ? '管理员密码' : 'Administrator password' %></label>
            <input id="admin-reauth-password" name="password" type="password" autocomplete="current-password" required maxlength="72">
            <p id="admin-reauth-error" class="admin-reauth-error" role="alert" aria-live="assertive" hidden></p>
            <div class="admin-reauth-actions">
                <button id="admin-reauth-cancel" type="button" class="btn-clear"><%= lang === 'zh' ? '取消' : 'Cancel' %></button>
                <button id="admin-reauth-submit" type="submit"><%= lang === 'zh' ? '验证并继续' : 'Verify and continue' %></button>
            </div>
        </form>
    </dialog>

    <style nonce="<%= cspNonce %>">
    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.8);
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        color: #fff;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #00c853;
    }

    .admin-header h1 {
        margin: 0;
        color: #00c853;
    }

    .nav-links {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .nav-links span {
        color: #ccc;
        font-weight: bold;
    }

    .nav-links a {
        color: #fff;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }

    .nav-links a:hover {
        background: rgba(0, 200, 83, 0.2);
        transform: translateY(-2px);
    }

    .admin-content {
        overflow-x: auto;
    }

    .recent-records {
        margin-top: 2rem;
    }

    .recent-records h2 {
        margin-bottom: 0.8rem;
        color: #ffeb3b;
    }

    .dictation-records {
        margin-top: 2rem;
    }

    .dictation-records h2 {
        margin-bottom: 0.8rem;
        color: #4dd0e1;
    }

    .dictation-latest {
        margin-top: 2rem;
    }

    .dictation-latest h2 {
        margin-bottom: 0.8rem;
        color: #81ecec;
    }

    .records-table-wrap {
        overflow-x: auto;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        padding: 0.5rem;
    }

    .records-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
        background: rgba(255, 255, 255, 0.03);
    }

    .records-table th {
        background: linear-gradient(135deg, #ffb300, #f57c00);
        color: #fff;
        padding: 0.7rem 0.5rem;
        text-align: left;
        font-weight: bold;
        font-size: 0.85rem;
    }

    .dictation-review-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .records-table td {
        padding: 0.6rem 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 0.85rem;
        color: #ddd;
        white-space: nowrap;
    }

    .records-table tr:hover {
        background: rgba(255, 255, 255, 0.04);
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        overflow: hidden;
    }

    .users-table th {
        background: linear-gradient(135deg, #00c853, #00bfa5);
        color: #fff;
        padding: 0.7rem 0.4rem;
        text-align: left;
        font-weight: bold;
        font-size: 0.85rem;
    }

    .users-table td {
        padding: 0.7rem 0.4rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        vertical-align: top;
        font-size: 0.85rem;
    }


    .users-table tr:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .user-link {
        color: #ffeb3b;
        text-decoration: none;
        font-weight: bold;
    }

    .user-link:hover {
        text-decoration: underline;
    }

    .spins {
        color: #e91e63;
        font-weight: bold;
        font-size: 1.1rem;
    }

    /* 按钮样式 */
    .users-table button {
        padding: 0.3rem 0.6rem;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
