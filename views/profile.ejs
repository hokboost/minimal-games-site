<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-redesign page-profile" data-csrf-token="<%= csrfToken %>" data-game-catalog="<%= encodeURIComponent(JSON.stringify((gameCatalog || []).filter((game) => game.recordView))) %>" data-record-views="<%= encodeURIComponent(JSON.stringify(gameRecordViews || {})) %>" data-wish-configs="<%= encodeURIComponent(JSON.stringify(gamePublicWishConfigs || {})) %>">
    <%- include('partials/language-switcher') %>

    <div class="container">
        <div class="profile-header">
            <h1><%= lang === 'zh' ? '个人资料' : 'Profile' %></h1>
            <div class="nav-links">
                <a href="/">← <%= lang === 'zh' ? '游戏大厅' : 'Games' %></a>
                <form method="POST" action="/logout" class="logout-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="logout-link-button"><%= lang === 'zh' ? '退出登录' : 'Log out' %></button>
                </form>
            </div>
        </div>

        <div class="profile-section">
            <h2><%= lang === 'zh' ? '账户概览' : 'Account overview' %></h2>
            <div class="info-grid">
                <div class="info-item">
                    <label><%= lang === 'zh' ? '用户名' : 'Username' %>:</label>
                    <span><%= user.username %></span>
                </div>
                <div class="info-item">
                    <label><%= lang === 'zh' ? '账户状态' : 'Account Status' %>:</label>
                    <span class="status <%= user.authorized ? 'authorized' : 'pending' %>">
                        <% if (user.authorized) { %>
                            <%= lang === 'zh' ? '已授权' : 'Authorized' %>
                        <% } else { %>
                            <%= lang === 'zh' ? '待授权' : 'Pending' %>
                        <% } %>
                    </span>
                </div>
                <div class="info-item">
                    <label><%= lang === 'zh' ? '积分余额' : 'Point Balance' %>:</label>
                    <span class="balance-count"><%= user.balance || 0 %> <%= lang === 'zh' ? '积分' : 'points' %></span>
                </div>
            </div>
        </div>

        <div class="profile-section">
            <h2><%= lang === 'zh' ? '游戏记录' : 'Game records' %></h2>
            <div class="game-stats-grid">
                <% (gameCatalog || []).filter((game) => game.recordView && gameStats[game.id]).forEach((game) => { const stats = gameStats[game.id]; %>
                    <div class="stat-card">
                        <div class="stat-icon"><%= game.index %></div>
                        <div class="stat-content">
                            <h3><%= lang === 'zh' ? game.titleZh : game.titleEn %></h3>
                            <div class="stat-numbers">
                                <span class="stat-main"><%= lang === 'zh' ? '记录数' : 'Records' %>: <%= stats.total %></span>
                                <% if (typeof stats.bestScore !== 'undefined') { %>
                                    <span class="stat-sub"><%= lang === 'zh' ? '最高分' : 'Best Score' %>: <%= stats.bestScore %></span>
                                <% } else if (typeof stats.wins !== 'undefined') { %>
                                    <span class="stat-sub"><%= lang === 'zh' ? '成功' : 'Wins' %>: <%= stats.wins %></span>
                                <% } else { %>
                                    <span class="stat-sub"><%= lang === 'zh' ? '查看详细记录' : 'View detailed history' %></span>
                                <% } %>
                            </div>
                            <button class="view-records-btn" data-records="<%= game.id %>"><%= lang === 'zh' ? '查看记录' : 'View Records' %></button>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>

        <div class="profile-section">
            <h2><%= lang === 'zh' ? '礼物背包' : 'Gift backpack' %></h2>
            <div class="backpack-toolbar">
                <button class="view-records-btn" id="refresh-backpack"><%= lang === 'zh' ? '刷新背包' : 'Refresh' %></button>
            </div>
            <div id="backpackContent" class="loading"><%= t.common.loading %></div>
        </div>


        <div id="gameRecordsModal" class="modal" hidden>
            <div class="modal-content records-modal">
                <div class="modal-header">
                    <h3 id="recordsTitle"><%= lang === 'zh' ? '游戏记录' : 'Game records' %></h3>
                    <button type="button" class="close" id="close-records" aria-label="<%= lang === 'zh' ? '关闭' : 'Close' %>" title="<%= lang === 'zh' ? '关闭' : 'Close' %>">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="recordsContent">
                        <div class="loading"><%= t.common.loading %></div>
                    </div>
                    <div id="recordsPagination" class="pagination"></div>
                </div>
            </div>
        </div>

        <div class="profile-section">
            <h2><%= lang === 'zh' ? '账户设置' : 'Account settings' %></h2>
            <div class="settings-grid">
                <button class="setting-btn" id="open-change-password"><%= lang === 'zh' ? '修改密码' : 'Change password' %></button>
                <button class="setting-btn" id="export-data"><%= lang === 'zh' ? '导出数据' : 'Export data' %></button>
            </div>
        </div>
    </div>

    
    <div id="changePasswordModal" class="modal" hidden>
        <div class="modal-content">
            <div class="modal-header">
                <h3><%= lang === 'zh' ? '修改密码' : 'Change password' %></h3>
                <button type="button" class="close" id="close-change-password" aria-label="<%= lang === 'zh' ? '关闭' : 'Close' %>" title="<%= lang === 'zh' ? '关闭' : 'Close' %>">&times;</button>
            </div>
            <div class="modal-body">
                <form id="changePasswordForm">
                    <div class="form-group">
                        <label for="currentPassword"><%= lang === 'zh' ? '当前密码' : 'Current Password' %>:</label>
                        <input type="password" id="currentPassword" name="currentPassword" required>
                    </div>
                    <div class="form-group">
                        <label for="newPassword"><%= lang === 'zh' ? '新密码' : 'New Password' %>:</label>
                        <input type="password" id="newPassword" name="newPassword" required minlength="12" maxlength="128" autocomplete="new-password">
                        <small><%= lang === 'zh' ? '12-128位，同时包含字母和数字' : '12-128 characters with letters and numbers' %></small>
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword"><%= lang === 'zh' ? '确认新密码' : 'Confirm New Password' %>:</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="12" maxlength="128" autocomplete="new-password">
                    </div>
                    <div class="form-actions">
                        <button type="button" id="cancel-change-password" class="btn-secondary"><%= t.game.cancel %></button>
                        <button type="submit" class="btn-primary"><%= lang === 'zh' ? '确认修改' : 'Confirm' %></button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    
    <div id="messageToast" class="toast" role="status" aria-live="polite" hidden></div>

    <style nonce="<%= cspNonce %>">
    .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.8);
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        color: #fff;
    }

    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        border-bottom: 2px solid #00c853;
        padding-bottom: 1rem;
    }

    .profile-header h1 {
        margin: 0;
        color: #00c853;
    }

    .nav-links {
        display: flex;
        gap: 1rem;
    }

    .nav-links a {
        color: #fff;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }

    .nav-links a:hover {
        background: rgba(0, 200, 83, 0.2);
        transform: translateY(-2px);
    }

    .profile-section {
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .profile-section h2 {
        color: #00c853;
        margin-bottom: 1rem;
        border-bottom: 1px solid #00c853;
        padding-bottom: 0.5rem;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .info-item label {
        font-weight: bold;
        color: #ccc;
    }

    .info-item span {
        color: #00c853;
        font-weight: bold;
    }

    .status.authorized {
        color: #4caf50;
    }

    .status.pending {
        color: #ff9800;
    }

    .balance-count {
        color: #e91e63 !important;
        font-size: 1.2rem;
    }

    .game-stats {
        color: #ccc;
        line-height: 1.6;
    }

    .game-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1.5rem;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: #00c853;
        transform: translateY(-2px);
    }

    .stat-icon {
        font-size: 3rem;
        text-align: center;
        margin-bottom: 1rem;
    }

    .stat-content h3 {
        color: #00c853;
        margin: 0 0 1rem 0;
        text-align: center;
    }

    .stat-numbers {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .stat-main {
        color: #fff;
        font-size: 1.1rem;
        font-weight: bold;
    }

    .stat-sub {
        color: #ccc;
        font-size: 0.9rem;
    }

    .view-records-btn {
        width: 100%;
        padding: 0.8rem;
        background: linear-gradient(135deg, #00c853, #00bfa5);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .view-records-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 200, 83, 0.4);
    }

    .records-modal .modal-content {
        max-width: 800px;
        max-height: 80vh;
        overflow: hidden;
    }

    .records-modal .modal-body {
        max-height: 60vh;
        overflow-y: auto;
    }

    .records-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1rem;
    }

    .records-table th,
    .records-table td {
        padding: 0.8rem;
        text-align: left;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .records-table th {
        background: rgba(0, 200, 83, 0.2);
        color: #00c853;
        font-weight: bold;
    }

    .records-table td {
        color: #ccc;
    }

    .records-table tr:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .backpack-toolbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 1rem;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .pagination button {
        padding: 0.5rem 1rem;
        background: rgba(255, 255, 255, 0.1);
        color: #ccc;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .pagination button:hover,
    .pagination button.active {
        background: #00c853;
        color: #fff;
    }

    .pagination button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .pagination-ellipsis {
        color: #777;
        padding: 0.5rem 0.2rem;
        user-select: none;
    }

    .loading {
        text-align: center;
        color: #ccc;
        padding: 2rem;
    }

    .settings-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .setting-btn {
        padding: 1rem 1.5rem;
        background: linear-gradient(135deg, rgba(0, 200, 83, 0.2), rgba(255, 255, 255, 0.05));
        border: 1px solid rgba(0, 200, 83, 0.3);
        border-radius: 10px;
        color: #00c853;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .setting-btn:hover {
        background: linear-gradient(135deg, rgba(0, 200, 83, 0.3), rgba(255, 255, 255, 0.1));
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 200, 83, 0.3);
    }

    /* 模态框样式 */
    .modal {
        display: block;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(5px);
    }

    .modal-content {
        background: linear-gradient(135deg, #1a1a2e, #16213e);
        margin: 5% auto;
        border: 2px solid #00c853;
        border-radius: 15px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        animation: modalSlideIn 0.3s ease;
    }

    @keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .modal-header {
        background: linear-gradient(135deg, #00c853, #00bfa5);
        color: #fff;
        padding: 1.5rem;
        border-radius: 13px 13px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 1.3rem;
    }

    .close {
        padding: 0;
        border: 0;
        background: transparent;
        color: #fff;
        font-size: 2rem;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.3s ease;
    }

    .close:hover {
        color: #ccc;
    }

    .modal-body {
        padding: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: #ccc;
        font-weight: bold;
    }

    .form-group input {
        width: 100%;
        padding: 0.8rem;
        border: 2px solid rgba(0, 200, 83, 0.3);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        font-size: 1rem;
        transition: border-color 0.3s ease;
        box-sizing: border-box;
    }

    .form-group input:focus {
        outline: none;
        border-color: #00c853;
        box-shadow: 0 0 10px rgba(0, 200, 83, 0.3);
    }

    .form-group small {
        display: block;
        margin-top: 0.3rem;
        color: #888;
        font-size: 0.85rem;
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        margin-top: 2rem;
    }

    .btn-primary, .btn-secondary {
        padding: 0.8rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, #00c853, #00bfa5);
        color: #fff;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 200, 83, 0.4);
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.1);
        color: #ccc;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
    }

    /* 消息提示样式 */
    .toast {
        position: fixed;
        top: 20px;
        right: 20px;
        padding: 1rem 1.5rem;
        border-radius: 8px;
        color: #fff;
        font-weight: bold;
        z-index: 1001;
        animation: toastSlideIn 0.3s ease;
    }

    @keyframes toastSlideIn {
        from {
            opacity: 0;
            transform: translateX(100%);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .toast.success {
        background: linear-gradient(135deg, #4caf50, #45a049);
    }

    .toast.error {
        background: linear-gradient(135deg, #f44336, #d32f2f);
    }

    .toast.info {
        background: linear-gradient(135deg, #2196f3, #1976d2);
    }

    @media (max-width: 768px) {
        .container {
            padding: 1rem;
        }
        
        .profile-header {
            flex-direction: column;
            gap: 1rem;
        }
        
        .info-grid {
            grid-template-columns: 1fr;
        }
        
        .settings-grid {
            grid-template-columns: 1fr;
        }
    }
    </style>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/security-alerts.js"></script>
    <script src="/js/profile.js"></script>
</body>
</html>
