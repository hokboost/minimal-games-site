<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-redesign page-login">
    <%- include('partials/language-switcher') %>
    <main class="container">
        <h1><%= lang === 'zh' ? '设置新密码' : 'Set a new password' %></h1>

        <% if (success) { %>
            <div class="success-message">
                <%= lang === 'zh' ? '密码已更新。所有旧会话均已退出，请使用新密码登录。' : 'Password updated. All previous sessions were signed out.' %>
            </div>
            <a class="btn-primary action-link" href="/login"><%= lang === 'zh' ? '前往登录' : 'Go to login' %></a>
        <% } else if (token) { %>
            <form method="POST" action="/reset-password" class="auth-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="token" value="<%= token %>">
                <div class="form-group">
                    <input type="password" name="newPassword" autocomplete="new-password" minlength="12" maxlength="128" placeholder="<%= lang === 'zh' ? '新密码' : 'New password' %>" required>
                </div>
                <div class="form-group">
                    <input type="password" name="confirmPassword" autocomplete="new-password" minlength="12" maxlength="128" placeholder="<%= lang === 'zh' ? '确认新密码' : 'Confirm new password' %>" required>
                </div>
                <button type="submit" class="btn-primary"><%= lang === 'zh' ? '更新密码' : 'Update password' %></button>
            </form>
        <% } %>

        <% if (error) { %>
            <div class="error-message"><%= error %></div>
        <% } %>
        <div class="auth-links"><a href="/login"><%= lang === 'zh' ? '返回登录' : 'Back to login' %></a></div>
    </main>
    <style nonce="<%= cspNonce %>">
        .container { max-width: 400px; margin: 50px auto; padding: 2rem; background: rgba(0, 0, 0, 0.82); border-radius: 8px; }
        h1 { color: #fff; text-align: center; margin-bottom: 1.5rem; }
        .auth-form { display: flex; flex-direction: column; gap: 1rem; }
        .form-group input { box-sizing: border-box; width: 100%; padding: 12px; border: 1px solid rgba(255,255,255,.3); border-radius: 6px; background: rgba(255,255,255,.1); color: #fff; font-size: 16px; }
        .btn-primary { display: block; box-sizing: border-box; width: 100%; padding: 12px; border: 0; border-radius: 6px; background: #00a86b; color: #fff; text-align: center; font-weight: 700; cursor: pointer; }
        .action-link { margin-top: 1rem; text-decoration: none; }
        .error-message, .success-message { margin-top: 1rem; padding: 10px; border-radius: 6px; text-align: center; }
        .error-message { color: #ff8a80; border: 1px solid rgba(255,82,82,.45); }
        .success-message { color: #69f0ae; border: 1px solid rgba(105,240,174,.4); }
        .auth-links { margin-top: 1.25rem; text-align: center; }
        .auth-links a { color: #69f0ae; }
    </style>
</body>
</html>
