<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f3f1eb">
    <title><%= lang === 'zh' ? 'Minimal Games 轻量游戏厅' : 'Minimal Games — Pocket Game Room' %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-redesign page-home" data-authorized="<%= user && user.authorized ? 'true' : 'false' %>" data-username="<%= user ? user.username : '' %>">
    <%- include('partials/language-switcher') %>

    <div class="site-layout">
        <%- include('partials/site-header', { active: 'home' }) %>

        <main class="site-main">
            <section class="hub-hero" aria-labelledby="hub-title">
                <div class="hub-copy">
                    <span class="eyebrow"><%= lang === 'zh' ? '轻量游戏合集' : 'A small collection of play' %></span>
                    <h1 id="hub-title">Minimal Games</h1>
                    <p><%= lang === 'zh' ? '不用下载，也不用复杂准备。选一个喜欢的玩法，现在就开一局。' : 'Nothing to install and nothing to prepare. Pick a game and start a quick round.' %></p>
                    <div class="hero-actions">
                        <% if (typeof user !== 'undefined' && user && user.authorized) { %>
                            <a class="hero-action-primary" href="#game-catalog"><%= lang === 'zh' ? '挑选游戏' : 'Browse games' %></a>
                            <a class="hero-action-secondary" href="/spin"><%= lang === 'zh' ? '随机挑战' : 'Surprise me' %> <span aria-hidden="true">→</span></a>
                        <% } else { %>
                            <a class="hero-action-primary" href="/login"><%= lang === 'zh' ? '登录开始' : 'Sign in to play' %></a>
                            <a class="hero-action-secondary" href="#game-catalog"><%= lang === 'zh' ? '先看看游戏' : 'Explore first' %></a>
                        <% } %>
                    </div>
                    <div class="hero-notes" aria-label="<%= lang === 'zh' ? '游戏厅概况' : 'Game room overview' %>">
                        <span><strong><%= (gameCatalog || []).length %></strong> <%= lang === 'zh' ? '款玩法' : 'games' %></span>
                        <span><strong>4</strong> <%= lang === 'zh' ? '种节奏' : 'ways to play' %></span>
                        <span><%= lang === 'zh' ? '纯虚拟娱乐' : 'Virtual play only' %></span>
                    </div>
                </div>
            </section>

            <%- include('partials/featured-track') %>

            <% if (!(typeof user !== 'undefined' && user && user.authorized)) { %>
                <section class="access-banner <%= user ? 'pending' : '' %>" aria-labelledby="access-title">
                    <div>
                        <h2 id="access-title"><%= user ? (lang === 'zh' ? '账号正在等待授权' : 'Account awaiting approval') : (lang === 'zh' ? '登录后即可开局' : 'Sign in to start playing') %></h2>
                        <p><%= user ? (lang === 'zh' ? '管理员授权后，全部游戏和礼物功能会自动开放。' : 'All games and gift features unlock after admin approval.') : (lang === 'zh' ? '创建账号，记录成绩、保存奖励并使用虚拟积分。' : 'Create an account to save scores, rewards, and virtual points.') %></p>
                    </div>
                    <div class="access-actions">
                        <% if (user) { %>
                            <form method="POST" action="/logout" class="logout-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="secondary"><%= lang === 'zh' ? '退出账号' : 'Log out' %></button>
                            </form>
                        <% } else { %>
                            <a href="/login" class="secondary"><%= t.auth.login %></a>
                            <a href="/register"><%= t.auth.register %></a>
                        <% } %>
                    </div>
                </section>
            <% } %>

            <section class="catalog-section" aria-labelledby="catalog-title">
                <div class="catalog-heading">
                    <div>
                        <span class="eyebrow"><%= lang === 'zh' ? '全部游戏' : 'All games' %></span>
                        <h2 id="catalog-title"><%= lang === 'zh' ? '选一种今天的节奏' : 'Choose today’s pace' %></h2>
                        <p><%= lang === 'zh' ? '想动脑、碰运气，还是来一次策略挑战？' : 'Think, test your luck, or take on a strategic challenge.' %></p>
                    </div>
                    <div class="catalog-filters" role="group" aria-label="<%= lang === 'zh' ? '筛选游戏类型' : 'Filter game category' %>">
                        <button type="button" class="active" data-catalog-filter="all" aria-pressed="true"><%= lang === 'zh' ? `全部 ${(gameCatalog || []).length}` : `All ${(gameCatalog || []).length}` %></button>
                        <button type="button" data-catalog-filter="brain" aria-pressed="false"><%= lang === 'zh' ? '益智' : 'Brain' %></button>
                        <button type="button" data-catalog-filter="chance" aria-pressed="false"><%= lang === 'zh' ? '运气' : 'Chance' %></button>
                        <button type="button" data-catalog-filter="strategy" aria-pressed="false"><%= lang === 'zh' ? '策略' : 'Strategy' %></button>
                        <button type="button" data-catalog-filter="challenge" aria-pressed="false"><%= lang === 'zh' ? '挑战' : 'Challenge' %></button>
                    </div>
                </div>

                <%- include('partials/game-catalog') %>
            </section>

            <% if (typeof user !== 'undefined' && user && user.authorized) { %>
                <section class="service-strip" aria-labelledby="service-title">
                    <span class="service-art" aria-hidden="true"><span>GIFT</span></span>
                    <div>
                        <span class="eyebrow"><%= lang === 'zh' ? '游戏之外' : 'Beyond the games' %></span>
                        <h2 id="service-title"><%= lang === 'zh' ? '把奖励带进直播间' : 'Bring your rewards to the stream' %></h2>
                        <p><%= lang === 'zh' ? '在礼物商店兑换、查看发送进度，管理祈愿得到的奖品。' : 'Redeem gifts, track delivery, and manage everything won from wishes.' %></p>
                    </div>
                    <a href="/gifts"><%= lang === 'zh' ? '打开礼物商店' : 'Open gift shop' %><span aria-hidden="true">→</span></a>
                </section>
            <% } %>
        </main>

        <%- include('partials/app-footer') %>
    </div>

    <% if (typeof user !== 'undefined' && user && user.authorized) { %>
        <script src="/socket.io/socket.io.js"></script>
        <script src="/security-alerts.js"></script>
        <script src="/js/index.js"></script>
    <% } %>
</body>
</html>
