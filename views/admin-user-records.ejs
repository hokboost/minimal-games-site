<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-redesign page-admin-user-records">
    <%- include('partials/language-switcher') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= lang === 'zh' ? '用户记录：' : 'User Records: ' %><%= targetUsername %></h1>
            <div class="nav-links">
                <a href="/admin">← <%= lang === 'zh' ? '管理后台' : 'Back to admin' %></a>
                <form method="POST" action="/logout" class="logout-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="logout-link-button"><%= lang === 'zh' ? '退出登录' : 'Log out' %></button>
                </form>
            </div>
        </div>

        <% const sections = typeof recordSections !== 'undefined' && Array.isArray(recordSections)
            ? recordSections
            : []; %>
        <% if (sections.length === 0) { %>
            <p><%= lang === 'zh' ? '暂无可用的游戏记录' : 'No game record providers are available' %></p>
        <% } %>

        <% sections.forEach(section => { %>
            <div class="records-section" data-record-view="<%= section.recordView %>">
                <h2><%= lang === 'zh' ? section.titleZh : section.titleEn %></h2>
                <table>
                    <thead>
                        <tr>
                            <% section.columns.forEach(column => { %>
                                <th><%= lang === 'zh' ? column.labelZh : column.labelEn %></th>
                            <% }) %>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (section.rows.length === 0) { %>
                            <tr>
                                <td colspan="<%= Math.max(1, section.columns.length) %>">
                                    <%= lang === 'zh' ? '暂无记录' : 'No records' %>
                                </td>
                            </tr>
                        <% } else { %>
                            <% section.rows.forEach(row => { %>
                                <tr>
                                    <% row.cells.forEach(cell => { %>
                                        <td><%= lang === 'zh' ? cell.zh : cell.en %></td>
                                    <% }) %>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% }) %>
    </div>

    <style nonce="<%= cspNonce %>">
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
            background: rgba(0, 0, 0, 0.85);
            border-radius: 15px;
            color: #fff;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #ffb300;
        }

        .admin-header h1 {
            margin: 0;
            color: #ffeb3b;
        }

        .nav-links {
            display: flex;
            gap: 1rem;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.1);
        }

        .records-section {
            margin-bottom: 2rem;
        }

        .records-section h2 {
            color: #00c853;
            margin-bottom: 0.6rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            overflow: hidden;
        }

        th, td {
            padding: 0.6rem 0.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-align: left;
            font-size: 0.85rem;
            white-space: nowrap;
        }

        th {
            background: linear-gradient(135deg, #00c853, #00bfa5);
            color: #fff;
        }
    </style>
</body>
</html>
