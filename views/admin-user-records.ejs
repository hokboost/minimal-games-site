<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-redesign page-admin-user-records">
    <%- include('partials/language-switcher') %>

    <div class="container">
        <div class="admin-header">
            <h1><%= lang === 'zh' ? '用户记录：' : 'User Records: ' %><%= targetUsername %></h1>
            <div class="nav-links">
                <a href="/admin">← <%= lang === 'zh' ? '管理后台' : 'Back to admin' %></a>
                <form method="POST" action="/logout" class="logout-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="logout-link-button"><%= lang === 'zh' ? '退出登录' : 'Log out' %></button>
                </form>
            </div>
        </div>

        <div class="records-section">
            <h2>Quiz</h2>
            <table>
                <thead>
                    <tr>
                        <th><%= lang === 'zh' ? '时间' : 'Time' %></th>
                        <th><%= lang === 'zh' ? '分数' : 'Score' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (records.quiz.length === 0) { %>
                        <tr><td colspan="2"><%= lang === 'zh' ? '暂无记录' : 'No records' %></td></tr>
                    <% } else { %>
                        <% records.quiz.forEach(row => { %>
                            <tr>
                                <td><%= row.played_at %></td>
                                <td><%= row.score %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="records-section">
            <h2>Slot</h2>
            <table>
                <thead>
                    <tr>
                        <th><%= lang === 'zh' ? '时间' : 'Time' %></th>
                        <th><%= lang === 'zh' ? '结果' : 'Result' %></th>
                        <th><%= lang === 'zh' ? '下注' : 'Bet' %></th>
                        <th><%= lang === 'zh' ? '倍数' : 'Multiplier' %></th>
                        <th><%= lang === 'zh' ? '派奖' : 'Payout' %></th>
                        <th><%= lang === 'zh' ? '面板' : 'Panel' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (records.slot.length === 0) { %>
                        <tr><td colspan="6"><%= lang === 'zh' ? '暂无记录' : 'No records' %></td></tr>
                    <% } else { %>
                        <% records.slot.forEach(row => { %>
                            <tr>
                                <td><%= row.played_at %></td>
                                <td><%= row.result %></td>
                                <td><%= row.bet_amount %></td>
                                <td><%= row.multiplier %></td>
                                <td><%= row.payout %></td>
                                <td><%= row.amounts %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="records-section">
            <h2>Scratch</h2>
            <table>
                <thead>
                    <tr>
                        <th><%= lang === 'zh' ? '时间' : 'Time' %></th>
                        <th><%= lang === 'zh' ? '档位' : 'Tier' %></th>
                        <th><%= lang === 'zh' ? '匹配' : 'Match' %></th>
                        <th><%= t.game.reward %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (records.scratch.length === 0) { %>
                        <tr><td colspan="4"><%= lang === 'zh' ? '暂无记录' : 'No records' %></td></tr>
                    <% } else { %>
                        <% records.scratch.forEach(row => { %>
                            <tr>
                                <td><%= row.played_at %></td>
                                <td><%= row.tier_cost %></td>
                                <td><%= row.matches_count %></td>
                                <td><%= row.reward %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="records-section">
            <h2>Wish</h2>
            <table>
                <thead>
                    <tr>
                        <th><%= lang === 'zh' ? '时间' : 'Time' %></th>
                        <th><%= lang === 'zh' ? '礼物' : 'Gift' %></th>
                        <th><%= lang === 'zh' ? '消耗' : 'Cost' %></th>
                        <th><%= lang === 'zh' ? '结果' : 'Result' %></th>
                        <th><%= t.game.reward %></th>
                        <th><%= lang === 'zh' ? '次数' : 'Count' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (records.wish.length === 0) { %>
                        <tr><td colspan="6"><%= lang === 'zh' ? '暂无记录' : 'No records' %></td></tr>
                    <% } else { %>
                        <% records.wish.forEach(row => { %>
                            <tr>
                                <td><%= row.played_at %></td>
                                <td><%= row.gift_type || '-' %></td>
                                <td><%= row.cost %></td>
                                <td><%= row.success ? lang === 'zh' ? '成功' : 'Success' : lang === 'zh' ? '失败' : 'Failed' %></td>
                                <td><%= row.reward || '-' %></td>
                                <td><%= row.wishes_count %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="records-section">
            <h2>Stone</h2>
            <table>
                <thead>
                    <tr>
                        <th><%= lang === 'zh' ? '时间' : 'Time' %></th>
                        <th><%= lang === 'zh' ? '动作' : 'Action' %></th>
                        <th><%= lang === 'zh' ? '消耗' : 'Cost' %></th>
                        <th><%= t.game.reward %></th>
                        <th><%= lang === 'zh' ? '槽位' : 'Slot' %></th>
                        <th><%= lang === 'zh' ? '变化' : 'Change' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (records.stone.length === 0) { %>
                        <tr><td colspan="6"><%= lang === 'zh' ? '暂无记录' : 'No records' %></td></tr>
                    <% } else { %>
                        <% records.stone.forEach(row => { %>
                            <tr>
                                <td><%= row.played_at %></td>
                                <td><%= row.action_type %></td>
                                <td><%= row.cost %></td>
                                <td><%= row.reward %></td>
                                <td><%= row.slot_index !== null ? row.slot_index : '-' %></td>
                                <td><%= row.before_slots %> → <%= row.after_slots %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="records-section">
            <h2>Flip</h2>
            <table>
                <thead>
                    <tr>
                        <th><%= lang === 'zh' ? '时间' : 'Time' %></th>
                        <th><%= lang === 'zh' ? '动作' : 'Action' %></th>
                        <th><%= lang === 'zh' ? '消耗' : 'Cost' %></th>
                        <th><%= t.game.reward %></th>
                        <th><%= lang === 'zh' ? '翻开' : 'Flipped' %></th>
                        <th><%= lang === 'zh' ? '好/坏' : 'Good/Bad' %></th>
                        <th><%= lang === 'zh' ? '结束' : 'Ended' %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (records.flip.length === 0) { %>
                        <tr><td colspan="7"><%= lang === 'zh' ? '暂无记录' : 'No records' %></td></tr>
                    <% } else { %>
                        <% records.flip.forEach(row => { %>
                            <tr>
                                <td><%= row.played_at %></td>
                                <td><%= row.action_type %></td>
                                <td><%= row.cost %></td>
                                <td><%= row.reward %></td>
                                <td><%= row.card_index !== null ? row.card_index : '-' %> / <%= row.card_type || '-' %></td>
                                <td><%= row.good_count %>/<%= row.bad_count %></td>
                                <td><%= row.ended ? lang === 'zh' ? '是' : 'Yes' : lang === 'zh' ? '否' : 'No' %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="records-section">
            <h2>Duel</h2>
            <table>
                <thead>
                    <tr>
                        <th><%= lang === 'zh' ? '时间' : 'Time' %></th>
                        <th><%= lang === 'zh' ? '礼物' : 'Gift' %></th>
                        <th><%= lang === 'zh' ? '功力' : 'Power' %></th>
                        <th><%= lang === 'zh' ? '消耗' : 'Cost' %></th>
                        <th><%= lang === 'zh' ? '结果' : 'Result' %></th>
                        <th><%= t.game.reward %></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (records.duel.length === 0) { %>
                        <tr><td colspan="6"><%= lang === 'zh' ? '暂无记录' : 'No records' %></td></tr>
                    <% } else { %>
                        <% records.duel.forEach(row => { %>
                            <tr>
                                <td><%= row.played_at %></td>
                                <td><%= row.gift_type %></td>
                                <td><%= row.power %>%</td>
                                <td><%= row.cost %></td>
                                <td><%= row.success ? lang === 'zh' ? '成功' : 'Success' : lang === 'zh' ? '失败' : 'Failed' %></td>
                                <td><%= row.reward %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <style nonce="<%= cspNonce %>">
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
            background: rgba(0, 0, 0, 0.85);
            border-radius: 15px;
            color: #fff;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #ffb300;
        }

        .admin-header h1 {
            margin: 0;
            color: #ffeb3b;
        }

        .nav-links {
            display: flex;
            gap: 1rem;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.1);
        }

        .records-section {
            margin-bottom: 2rem;
        }

        .records-section h2 {
            color: #00c853;
            margin-bottom: 0.6rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            overflow: hidden;
        }

        th, td {
            padding: 0.6rem 0.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            text-align: left;
            font-size: 0.85rem;
            white-space: nowrap;
        }

        th {
            background: linear-gradient(135deg, #00c853, #00bfa5);
            color: #fff;
        }
    </style>
</body>
</html>
