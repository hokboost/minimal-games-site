<!DOCTYPE html><html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= title %></title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/redesign.css"><link rel="stylesheet" href="/story-world.css"></head>
<body class="app-redesign story-world"><%- include('partials/language-switcher') %><div class="site-layout"><%- include('partials/site-header', { active: 'admin' }) %><main class="story-shell"><header class="story-hero"><h1><%= title %></h1><p><%= lang === 'zh' ? '只读事件审计。答案、隐藏条件和未来分支不会显示。' : 'Read-only event audit. Answers, hidden conditions, and future branches are not shown.' %></p></header><section class="story-card"><table><thead><tr><th>ID</th><th><%= lang === 'zh' ? '用户' : 'User' %></th><th><%= lang === 'zh' ? '动作' : 'Action' %></th><th><%= lang === 'zh' ? '时间' : 'Time' %></th></tr></thead><tbody><% audit.events.forEach((event) => { %><tr><td><%= event.id %></td><td><%= event.username || '-' %></td><td><%= event.action %></td><td><%= event.created_at %></td></tr><% }) %></tbody></table></section></main><%- include('partials/app-footer') %></div></body></html>
