<!DOCTYPE html><html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= title %></title>
<link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/redesign.css"><link rel="stylesheet" href="/story-world.css"><link rel="stylesheet" href="/creator-shell.css"></head>
<body class="app-redesign story-world" data-csrf-token="<%= csrfToken %>" data-lang="<%= lang %>"><%- include('partials/language-switcher') %>
<div class="site-layout"><%- include('partials/site-header', { active: 'creator' }) %><main class="story-shell">
<header class="story-hero"><p><%= lang === 'zh' ? '主播世界 · 持久分支故事' : 'Creator World · Persistent branching story' %></p><h1><%= title %></h1><p><%= lang === 'zh' ? '选择会留下长期旗标、关系变化与共享记忆。重玩不会重复发放任何价值。' : 'Choices leave lasting flags, relationship changes, and shared memories. Replay never grants value twice.' %></p><a href="/creator"><%= lang === 'zh' ? '返回主播世界' : 'Back to Creator World' %></a></header>
<section id="story-stage" class="story-card" aria-live="polite"></section><section class="story-progress"><h2><%= lang === 'zh' ? '长期航迹' : 'Lasting route' %></h2><div id="story-axes"></div><ul id="story-unlocks"></ul></section>
<p id="story-message" role="status" aria-live="polite"></p></main><%- include('partials/app-footer') %></div>
<script id="story-bootstrap" type="application/json"><%- JSON.stringify(initialState).replace(/</g, '\\u003c') %></script><script src="/js/i18n-helpers.js"></script><script src="/js/creator-shell.js"></script><script src="/js/creator-operation-center.js"></script><script src="/js/creator-responsive-navigation.js"></script><script src="/js/creator-context-help.js"></script><script src="/js/story-world.js"></script><script src="/js/story-archive-experience.js"></script></body></html>
