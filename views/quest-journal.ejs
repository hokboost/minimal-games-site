<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/redesign.css"><link rel="stylesheet" href="/quest-world.css"><link rel="stylesheet" href="/creator-shell.css">
</head>
<body class="app-redesign quest-world" data-csrf-token="<%= csrfToken %>" data-lang="<%= lang %>">
<%- include('partials/language-switcher') %>
<div class="site-layout"><%- include('partials/site-header', { active: 'creator' }) %>
<main class="quest-shell">
    <header class="quest-hero"><div><span><%= lang === 'zh' ? '主播世界 · 自愿任务' : 'Creator World · Opt-in quests' %></span><h1><%= title %></h1><p><%= lang === 'zh' ? '拒绝、延后或退出都不会扣除关系等级，也不会影响礼物资格。浏览器证据必须经过审核，不能直接发放积分。' : 'Declining, postponing, or leaving never reduces relationship level or gift eligibility. Browser evidence requires review and cannot directly award points.' %></p></div><a href="/creator"><%= lang === 'zh' ? '返回主播世界' : 'Back to Creator World' %></a></header>
    <section id="quest-active-panel" class="quest-panel"><h2><%= lang === 'zh' ? '我的进行中任务' : 'My active quests' %></h2>
    <% const active = journal.assignments.filter((q) => ['offered','accepted','active','submitted','under_review','returned'].includes(q.status)); %>
    <% if (!active.length) { %><p><%= lang === 'zh' ? '目前没有进行中的任务。你可以从周板自主选择。' : 'No active quests. Choose one from a board when you want.' %></p><% } %>
    <div class="quest-grid"><% active.forEach((quest) => { %><article class="quest-card" data-assignment-id="<%= quest.id %>" data-revision="<%= quest.revision %>"><small><%= quest.category %> · <%= quest.difficulty %></small><h3><%= lang === 'zh' ? quest.title_zh : quest.title_en %></h3><p><%= lang === 'zh' ? quest.description_zh : quest.description_en %></p><p><strong><%= quest.reward_points %></strong> <%= lang === 'zh' ? '积分（审核/可信事件后）' : 'points (after review/trusted event)' %> · <%= quest.status %></p><div class="quest-actions"><% if (quest.status === 'offered') { %><button data-action="accept"><%= lang === 'zh' ? '接受' : 'Accept' %></button><button data-action="decline"><%= lang === 'zh' ? '拒绝，无惩罚' : 'Decline, no penalty' %></button><button data-action="postpone"><%= lang === 'zh' ? '延后一天' : 'Postpone one day' %></button><% } %><% if (quest.status === 'active' || quest.status === 'returned') { %><button data-action="submit"><%= lang === 'zh' ? '提交审核' : 'Submit for review' %></button><button data-action="decline"><%= lang === 'zh' ? '退出，无惩罚' : 'Leave, no penalty' %></button><% } %></div><ol><% quest.steps.forEach((step) => { %><li><strong><%= lang === 'zh' ? step.title_zh : step.title_en %></strong> · <%= step.status || 'locked' %><% if (['text','checklist','png'].includes(step.evidence_kind) && ['active','returned'].includes(step.status)) { %><form class="evidence-form" data-step-id="<%= step.step_id %>" data-kind="<%= step.evidence_kind %>"><% if (step.evidence_kind === 'png') { %><label><%= lang === 'zh' ? 'PNG 证据（最大 768KB）' : 'PNG evidence (768 KB maximum)' %><input type="file" accept="image/png" required></label><% } else { %><label><%= lang === 'zh' ? '有界证据（纯文本）' : 'Bounded evidence (plain text)' %><textarea maxlength="2000" required></textarea></label><% } %><button type="submit"><%= lang === 'zh' ? '保存证据' : 'Save evidence' %></button></form><% } %></li><% }); %></ol></article><% }); %></div></section>
    <section id="quest-board-panel" class="quest-panel"><h2><%= lang === 'zh' ? '每周任务板' : 'Weekly boards' %></h2><div class="quest-grid"><% journal.boards.forEach((slot) => { %><article class="quest-card" data-kind="<%= slot.verification_mode %>" data-points="<%= slot.reward_points %>"><small><%= lang === 'zh' ? slot.board_title_zh : slot.board_title_en %> · #<%= slot.slot_number %></small><h3><%= lang === 'zh' ? slot.title_zh : slot.title_en %></h3><p><%= lang === 'zh' ? slot.description_zh : slot.description_en %></p><p><%= slot.reward_points %> · <%= slot.verification_mode %></p><% if (!slot.assignment_id || !['offered','accepted','active','submitted','under_review','returned'].includes(slot.assignment_status)) { %><button data-action="claim" data-version-id="<%= slot.version_id %>" data-board-id="<%= slot.board_id %>"><%= lang === 'zh' ? '加入日志' : 'Add to journal' %></button><% } else { %><span><%= lang === 'zh' ? '已在日志中' : 'Already in journal' %></span><% } %></article><% }); %></div></section>
    <section id="quest-chain-panel" class="quest-panel"><h2><%= lang === 'zh' ? '任务链' : 'Quest chains' %></h2><div class="quest-grid"><% journal.chains.forEach((node) => { %><article class="quest-card" data-chain-status="<%= node.assignment_status || 'available' %>" data-chain-number="<%= node.node_number %>"><small><%= lang === 'zh' ? node.chain_title_zh : node.chain_title_en %> · <%= node.node_number %></small><h3><%= lang === 'zh' ? node.title_zh : node.title_en %></h3><p><%= node.assignment_status || (lang === 'zh' ? '尚未领取' : 'Not claimed') %></p><% if (!node.assignment_id) { %><button data-action="claim" data-version-id="<%= node.version_id %>" data-chain-id="<%= node.chain_id %>"><%= lang === 'zh' ? '领取此链节点' : 'Claim chain node' %></button><% } %></article><% }); %></div></section>
    <section class="quest-panel"><h2><%= lang === 'zh' ? '旧任务卡历史（只读）' : 'Legacy task-card history (read-only)' %></h2><ul><% journal.legacy.forEach((card) => { %><li><%= lang === 'zh' ? card.title_zh : card.title_en %> · <%= card.status %> <button data-action="legacy-import" data-task-card-id="<%= card.id %>"><%= lang === 'zh' ? '导入历史（不重复奖励）' : 'Import history (no duplicate reward)' %></button></li><% }); %></ul></section>
    <p id="quest-message" role="status" aria-live="polite"></p>
</main><%- include('partials/app-footer') %></div><script src="/js/i18n-helpers.js"></script><script src="/js/creator-shell.js"></script><script src="/js/creator-operation-center.js"></script><script src="/js/creator-responsive-navigation.js"></script><script src="/js/creator-context-help.js"></script><script src="/js/creator-explorer.js"></script><script src="/js/quest-journal.js"></script><script src="/js/quest-journal-experience.js"></script>
</body></html>
