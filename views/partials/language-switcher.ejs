<link rel="stylesheet" href="/redesign.css">
<link rel="stylesheet" href="/redesign-games.css">
<link rel="stylesheet" href="/redesign-account.css">

<div class="language-switcher">
    <button type="button" id="privacy-settings-button" class="privacy-settings-button"
            title="<%= lang === 'zh' ? '隐私设置' : 'Privacy settings' %>"
            aria-label="<%= lang === 'zh' ? '隐私设置' : 'Privacy settings' %>">
        <%= lang === 'zh' ? '隐私' : 'Privacy' %>
    </button>
    <% if (lang === 'zh') { %>
        <a href="/set-language/en" class="lang-btn" title="Switch to English" aria-label="Switch to English">
            EN
        </a>
    <% } else { %>
        <a href="/set-language/zh" class="lang-btn" title="切换为中文" aria-label="切换为中文">
            中文
        </a>
    <% } %>
</div>

<%- include('persistent-music-player') %>

<script src="/js/idempotent-fetch.js"></script>
<script src="/js/i18n-helpers.js"></script>
<script src="/js/ui-shell.js" defer></script>
<script src="/js/ux-analytics.js" defer></script>
<script src="/js/music-player.js" defer></script>
