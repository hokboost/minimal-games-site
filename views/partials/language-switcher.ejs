<link rel="stylesheet" href="/redesign.css">
<link rel="stylesheet" href="/redesign-games.css">
<link rel="stylesheet" href="/redesign-account.css">

<div class="language-switcher">
    <% if (lang === 'zh') { %>
        <a href="/set-language/en" class="lang-btn" title="Switch to English" aria-label="Switch to English">
            EN
        </a>
    <% } else { %>
        <a href="/set-language/zh" class="lang-btn" title="切换为中文" aria-label="切换为中文">
            中文
        </a>
    <% } %>
</div>

<script src="/js/i18n-helpers.js"></script>
<script src="/js/ui-shell.js" defer></script>
