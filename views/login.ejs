<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-redesign page-login">
    <%- include('partials/language-switcher') %>

    <div class="container">
        <h1><%= t.auth.login %> Minimal Games</h1>
        <form method="POST" action="/login" class="auth-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-group">
                <input type="text" name="username" placeholder="<%= t.auth.username %>" required />
            </div>

            <div class="form-group">
                <input type="password" name="password" placeholder="<%= t.auth.password %>" required />
            </div>

            <div class="form-group">
                <input type="text" name="totpCode" inputmode="numeric" pattern="[0-9]{6}"
                       autocomplete="one-time-code"
                       placeholder="<%= lang === 'zh' ? '管理员动态验证码（普通用户留空）' : 'Admin authenticator code (users leave blank)' %>" />
            </div>

            <button type="submit" class="btn-primary"><%= t.auth.loginButton %></button>
        </form>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error-message"><%= error %></div>
        <% } %>

        <% if (typeof req !== 'undefined' && req.query && req.query.registered === 'true') { %>
            <div class="success-message">
                <%= lang === 'zh' ? '注册成功，请登录您的账户。' : 'Registration successful. Please log in to your account.' %>
            </div>
        <% } %>

        <% if (typeof req !== 'undefined' && req.query && req.query.kicked === 'true') { %>
            <div class="warning-message">
                <%= lang === 'zh' ? '您的账号已在其他设备登录，请重新登录。' : 'Your account was used on another device. Please log in again.' %>
            </div>
        <% } %>

        <div class="auth-links">
            <%= t.auth.noAccount %> <a href="/register"><%= t.auth.goRegister %></a>
            <br>
            <a href="/">← <%= lang === 'zh' ? '返回首页' : 'Back to Home' %></a>
        </div>
    </div>

    <style nonce="<%= cspNonce %>">
    .container {
        max-width: 400px;
        margin: 50px auto;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.8);
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    h1 {
        text-align: center;
        color: #fff;
        margin-bottom: 2rem;
    }

    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .form-group input {
        width: 100%;
        padding: 12px;
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        font-size: 16px;
        box-sizing: border-box;
    }

    .form-group input:focus {
        outline: none;
        border-color: #00c853;
        box-shadow: 0 0 10px rgba(0, 200, 83, 0.3);
    }

    .form-group input::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    .btn-primary {
        width: 100%;
        padding: 12px;
        background: linear-gradient(90deg, #00c853, #00bfa5);
        color: white;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background: linear-gradient(90deg, #00e676, #1de9b6);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 200, 83, 0.4);
    }

    .error-message {
        background: rgba(255, 0, 0, 0.1);
        color: #ff6666;
        padding: 10px;
        margin-top: 15px;
        border-radius: 8px;
        border: 1px solid rgba(255, 0, 0, 0.3);
        text-align: center;
    }

    .success-message {
        background: rgba(0, 255, 0, 0.1);
        color: #66ff66;
        padding: 10px;
        margin-top: 15px;
        border-radius: 8px;
        border: 1px solid rgba(0, 255, 0, 0.3);
        text-align: center;
    }

    .auth-links {
        margin-top: 20px;
        text-align: center;
        color: #ccc;
    }

    .auth-links a {
        color: #00c853;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .auth-links a:hover {
        color: #00e676;
    }

    .warning-message {
        background: rgba(255, 165, 0, 0.1);
        color: #ff9800;
        padding: 10px;
        margin-top: 15px;
        border-radius: 8px;
        border: 1px solid rgba(255, 165, 0, 0.3);
        text-align: center;
    }
    </style>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/security-alerts.js"></script>
</body>
</html>
