<!DOCTYPE html><html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/redesign.css"><link rel="stylesheet" href="/creator-rewards.css"></head>
<body class="app-redesign reward-world" data-csrf-token="<%= csrfToken %>" data-lang="<%= lang %>"><%- include('partials/language-switcher') %><div class="site-layout"><%- include('partials/site-header', { active: 'admin' }) %><main class="reward-shell">
<header class="reward-hero"><div><span><%= lang === 'zh' ? '结构化授予 · 独立审批' : 'Structured grants · Independent review' %></span><h1><%= title %></h1><p><%= lang === 'zh' ? '此处只创建奖励权益，不会调用送礼 provider。' : 'This studio creates entitlements and never invokes the gift provider.' %></p></div><a href="/admin"><%= lang === 'zh' ? '返回管理后台' : 'Back to admin' %></a></header>
<section class="reward-panel" id="reward-grant-panel" <%= state.canGrant ? '' : 'hidden' %>><h2><%= lang === 'zh' ? '主播互动导演授予' : 'Creator Director grant' %></h2><form id="reward-grant-form" class="reward-form"><label><%= lang === 'zh' ? '主播用户名' : 'Creator username' %><input name="creatorUsername" required minlength="3" maxlength="32"></label><label><%= lang === 'zh' ? '奖励' : 'Reward' %><select name="catalogVersionId"><% state.grantItems.forEach((item) => { %><option value="<%= item.id %>"><%= lang === 'zh' ? item.titleZh : item.titleEn %><%= item.requiresApproval ? ' · review' : '' %></option><% }); %></select></label><label><%= lang === 'zh' ? '受限模板' : 'Bounded template' %><select name="templateKey"><% state.grantTemplates.forEach((item) => { %><option value="<%= item.key %>"><%= lang === 'zh' ? item.titleZh : item.titleEn %></option><% }); %></select></label><button type="submit"><%= lang === 'zh' ? '创建可领取权益' : 'Create claimable entitlement' %></button></form></section>
<section class="reward-panel"><h2><%= lang === 'zh' ? '待审批高价值订单' : 'High-value review queue' %></h2><div class="reward-grid"><% state.pending.forEach((order) => { %><article class="reward-card" data-order-id="<%= order.id %>"><small><%= order.creatorUsername %> · <%= order.sourceType %></small><h3><%= lang === 'zh' ? order.titleZh : order.titleEn %></h3><p><%= order.pointsCost %> points · exposure <%= order.exposureValue %></p><div class="reward-actions"><button data-review="approve"><%= lang === 'zh' ? '批准' : 'Approve' %></button><button data-review="reject"><%= lang === 'zh' ? '拒绝' : 'Reject' %></button></div></article><% }); %></div><% if (!state.pending.length) { %><p><%= lang === 'zh' ? '暂无待审批项。' : 'Nothing is awaiting review.' %></p><% } %></section>
<section class="reward-panel"><h2><%= lang === 'zh' ? '奖励派发死信' : 'Reward grant dead letters' %></h2><div class="reward-grid"><% (state.deadLetters || []).forEach((intent) => { %><article class="reward-card"><small><%= intent.sourceType %> · <%= intent.creatorUsername %></small><h3><%= intent.catalogSlug %></h3><p><%= intent.errorCode %> · <%= intent.attempts %> attempts</p><p><%= intent.errorDetail %></p></article><% }); %></div><% if (!(state.deadLetters || []).length) { %><p><%= lang === 'zh' ? '暂无死信。' : 'No dead-lettered grants.' %></p><% } %></section><p id="reward-message" role="status" aria-live="polite"></p>
</main><%- include('partials/app-footer') %></div><script src="/js/i18n-helpers.js"></script><script src="/js/admin-creator-rewards.js"></script></body></html>
