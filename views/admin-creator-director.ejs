<!DOCTYPE html><html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= title %></title>
<link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/redesign.css"><link rel="stylesheet" href="/creator-world.css"><link rel="stylesheet" href="/live-interactions.css"><link rel="stylesheet" href="/creator-shell.css"></head>
<body class="app-redesign creator-world live-world" data-csrf-token="<%= csrfToken %>" data-lang="<%= lang %>"><%- include('partials/language-switcher') %><div class="site-layout"><%- include('partials/site-header',{active:'admin'}) %><main class="live-shell">
<header class="live-hero"><div><p class="live-kicker"><%= liveEnabled?(lang==='zh'?'配置站主 · 结构化导演台':'Configured owner · Structured Director'):(lang==='zh'?'管理员 · 安全只读':'Admin · Safe read only') %></p><h1><%= title %></h1><p><%= lang==='zh'?'这里只显示当前任务、剧情位置、邀请和非敏感事件。所有发送都从固定双语模板选择，安静时间与静音由服务端强制执行。':'Only current quests, story position, invitations, and non-sensitive history appear here. Every send uses a fixed bilingual template; quiet hours and mute are enforced server-side.' %></p><p><%= ownerUsername?(lang==='zh'?`配置站主：${ownerUsername}`:`Configured owner: ${ownerUsername}`):(lang==='zh'?'尚未配置站主，所有实时写操作关闭。':'No owner is configured; all live mutations are closed.') %></p></div><div><a href="/admin"><%= lang==='zh'?'返回管理后台':'Back to admin' %></a><% if(rewardsEnabled){ %><br><a href="/admin/creator-rewards"><%= lang==='zh'?'奖励审核与授予':'Reward review and grants' %></a><% } %></div></header>
<section class="live-panel"><h2><%= lang==='zh'?'主播概览':'Creator overview' %></h2><div class="creator-table-wrap"><table class="creator-table"><thead><tr><th><%= lang==='zh'?'账号':'Account' %></th><th><%= lang==='zh'?'同意与在线':'Consent & presence' %></th><th><%= lang==='zh'?'关系':'Relationship' %></th><th><%= lang==='zh'?'B站与申请':'Bilibili & request' %></th><th><%= lang==='zh'?'当前上下文':'Current context' %></th><th><%= lang==='zh'?'联络室':'Relay room' %></th></tr></thead><tbody>
<% summary.creators.forEach((creator)=>{ const interaction=creator.interaction||null; %><tr data-creator="<%= creator.username %>" data-interaction-id="<%= interaction?interaction.id:'' %>" data-revision="<%= interaction?interaction.revision:0 %>"><td><strong><%= creator.displayName||creator.username %></strong><br><small><%= creator.username %> · <%= creator.timezone||'UTC' %></small></td><td><%= creator.liveInteractionOptIn?(lang==='zh'?'已同意':'Opted in'):(lang==='zh'?'未同意':'Off') %><br><small><%= creator.presence||'offline' %></small></td><td>Lv.<%= creator.level||1 %> · <%= creator.totalXp||0 %> XP<br><small><%= (creator.milestone||'new_signal').replaceAll('_',' ') %></small></td><td><%= creator.bilibiliRoomId||'—' %><br><small><%= creator.roomRequest?`${creator.roomRequest.requestedRoomId} · ${creator.roomRequest.status}`:(lang==='zh'?'无最近申请':'No recent request') %></small></td><td><small><%= creator.currentQuest?(lang==='zh'?`任务 #${creator.currentQuest.id} · ${creator.currentQuest.status}`:`Quest #${creator.currentQuest.id} · ${creator.currentQuest.status}`):(lang==='zh'?'无当前任务':'No current quest') %></small><br><small><%= creator.currentStory?(lang==='zh'?`剧情 ${creator.currentStory.episode} · ${creator.currentStory.nodeId}`:`Story ${creator.currentStory.episode} · ${creator.currentStory.nodeId}`):(lang==='zh'?'无当前剧情':'No current story') %></small><% if(interaction&&(interaction.currentItems?.length||interaction.recentHistory?.length)){ %><details><summary><%= lang==='zh'?'邀请与非敏感历史':'Invites & safe history' %></summary><% (interaction.currentItems||[]).forEach((item)=>{ %><small><%= item.itemType %> · <%= item.status %></small><br><% }); %><% (interaction.recentHistory||[]).forEach((event)=>{ %><small>#<%= event.sequence %> · <%= event.eventType %></small><br><% }); %></details><% } %></td><td><% if(interaction){ %><strong>#<%= interaction.id %> · <%= interaction.status %></strong><br><small>rev <%= interaction.revision %> · seq <%= interaction.lastSequence %> · <%= interaction.pendingCount %> pending</small><% }else{ %>—<% } %><% if(liveEnabled&&creator.liveInteractionOptIn){ %><div class="live-actions"><% if(!interaction||interaction.status!=='active'){ %><button type="button" class="live-button" data-director-action="open"><%= lang==='zh'?'建立联络室':'Open relay' %></button><% }else{ %><button type="button" class="live-button" data-director-action="compose"><%= lang==='zh'?'发送结构化互动':'Send structured item' %></button><% } %></div><% } %></td></tr><% }); %></tbody></table></div>
<% if(!summary.creators.length){ %><p class="live-empty"><%= lang==='zh'?'暂无主播资料。':'No creator profiles yet.' %></p><% } %></section>
<nav class="creator-pagination" aria-label="<%= lang==='zh'?'分页':'Pagination' %>"><% if(summary.page>1){ %><a href="?page=<%= summary.page-1 %>"><%= lang==='zh'?'上一页':'Previous' %></a><% } %><span><%= lang==='zh'?`第 ${summary.page} 页`:`Page ${summary.page}` %></span><% if(summary.creators.length===summary.pageSize){ %><a href="?page=<%= summary.page+1 %>"><%= lang==='zh'?'下一页':'Next' %></a><% } %></nav>
<% if(liveEnabled){ %><section id="director-composer" class="live-panel" hidden><h2><%= lang==='zh'?'结构化发送':'Structured send' %></h2><p id="director-target"></p><label><%= lang==='zh'?'模板':'Template' %><select id="director-template"></select></label><div id="director-fields"></div><div class="live-actions"><button type="button" class="live-button" id="director-send"><%= lang==='zh'?'持久保存并发送':'Persist and send' %></button><button type="button" class="live-button secondary" id="director-cancel"><%= lang==='zh'?'取消':'Cancel' %></button></div></section>
<section class="live-panel"><h2><%= lang==='zh'?'举报审核':'Report review' %></h2><div id="director-reports"><% (summary.reports||[]).forEach((report)=>{ %><article class="live-item" data-report-id="<%= report.id %>" data-interaction-id="<%= report.interactionId %>"><div class="live-item-head"><strong><%= report.reporterUsername %> · <%= report.reasonCode %></strong><span class="live-status"><%= report.status %></span></div><p><%= report.detail %></p><small>#<%= report.interactionId %> · <%= report.itemType||'room' %></small><% if(['open','reviewing'].includes(report.status)){ %><div class="live-actions"><button class="live-button" type="button" data-report-action="resolved"><%= lang==='zh'?'确认已处理':'Resolve' %></button><button class="live-button secondary" type="button" data-report-action="dismissed"><%= lang==='zh'?'驳回举报':'Dismiss' %></button></div><% } %></article><% }); %></div></section><% } %>
<p id="director-message" role="alert"></p></main><%- include('partials/app-footer') %></div>
<script id="director-bootstrap" type="application/json"><%- JSON.stringify({templates:summary.templates||[]}).replace(/</g,'\\u003c') %></script><script src="/js/i18n-helpers.js"></script><script src="/js/creator-shell.js"></script><script src="/js/creator-operation-center.js"></script><script src="/js/creator-responsive-navigation.js"></script><script src="/js/creator-context-help.js"></script><script src="/js/admin-workspace-experience.js"></script><script src="/js/creator-table-access.js"></script><% if(liveEnabled){ %><script src="/js/admin-live-director.js"></script><% } %></body></html>
