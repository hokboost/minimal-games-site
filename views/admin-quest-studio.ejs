<!DOCTYPE html><html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/redesign.css"><link rel="stylesheet" href="/quest-world.css"><link rel="stylesheet" href="/creator-shell.css"></head>
<body class="app-redesign quest-world" data-csrf-token="<%= csrfToken %>"><%- include('partials/language-switcher') %><div class="site-layout"><%- include('partials/site-header', { active: 'admin' }) %><main class="quest-shell">
<header class="quest-hero"><div><span><%= lang === 'zh' ? '管理员 · 版本化内容' : 'Admin · Versioned content' %></span><h1><%= title %></h1><p><%= lang === 'zh' ? '已发布版本不可原地修改；可信事件只能从注册列表选择。所有审核与积分结算处于同一事务。' : 'Published versions cannot be edited in place. Trusted events come from a registered list. Review and point settlement share one transaction.' %></p></div><a href="/admin"><%= lang === 'zh' ? '返回管理后台' : 'Back to admin' %></a></header>
<section class="quest-panel"><h2><%= lang === 'zh' ? '创建受限草稿' : 'Create a constrained draft' %></h2><form id="quest-draft-form" class="quest-builder"><label>Slug<input name="slug" pattern="[a-z][a-z0-9-]{2,119}" required></label><label><%= lang === 'zh' ? '版本' : 'Version' %><input name="version" type="number" min="1" max="1000000" value="1" required></label><label><%= lang === 'zh' ? '中文标题' : 'Chinese title' %><input name="titleZh" maxlength="240" required></label><label><%= lang === 'zh' ? '英文标题' : 'English title' %><input name="titleEn" maxlength="240" required></label><label><%= lang === 'zh' ? '中文说明' : 'Chinese description' %><textarea name="descriptionZh" maxlength="1200" required></textarea></label><label><%= lang === 'zh' ? '英文说明' : 'English description' %><textarea name="descriptionEn" maxlength="1200" required></textarea></label><label><%= lang === 'zh' ? '类别' : 'Category' %><select name="category"><option value="creativity">creativity</option><option value="exploration">exploration</option><option value="game_mastery">game_mastery</option><option value="story">story</option><option value="streaming_practice">streaming_practice</option><option value="coop">coop</option><option value="community">community</option><option value="collection">collection</option><option value="wellbeing">wellbeing</option></select></label><label><%= lang === 'zh' ? '验证' : 'Verification' %><select name="verificationMode"><option value="manual">manual</option><option value="automatic">automatic</option></select></label><label><%= lang === 'zh' ? '证据' : 'Evidence' %><select name="evidenceKind"><option value="text">text</option><option value="checklist">checklist</option><option value="png">png</option><option value="trusted_event">trusted_event</option></select></label><label><%= lang === 'zh' ? '注册可信事件' : 'Registered trusted event' %><select name="eventType"><option value="quiz.round.completed">quiz.round.completed</option><option value="adventure.chapter.completed">adventure.chapter.completed</option><option value="doudizhu.match.won">doudizhu.match.won</option></select></label><label><%= lang === 'zh' ? '积分' : 'Points' %><input name="rewardPoints" type="number" min="0" max="100000000" value="0"></label><button type="submit"><%= lang === 'zh' ? '保存草稿' : 'Save draft' %></button></form></section>
<section class="quest-panel"><h2><%= lang === 'zh' ? '待审核证据' : 'Pending evidence review' %></h2><div class="quest-grid"><% reviewQueue.forEach((item) => { %><article class="quest-card"><small><%= item.username %> · #<%= item.id %> · <%= item.step_key %></small><h3><%= lang === 'zh' ? item.title_zh : item.title_en %></h3><p><%= item.evidence_kind %> · SHA-256 <%= item.content_sha256 %></p><% if (item.evidence_kind === 'png') { %><p><%= item.width %>×<%= item.height %> · <%= item.byte_count %> bytes · <%= item.redacted_at ? 'redacted' : 'retained' %></p><% } else { %><pre><%= JSON.stringify(item.content, null, 2) %></pre><% } %><label><%= lang === 'zh' ? '审核说明' : 'Review note' %><textarea data-review-note maxlength="1000"></textarea></label><div class="quest-actions"><button data-review="approved" data-assignment-id="<%= item.id %>"><%= lang === 'zh' ? '批准并结算' : 'Approve and settle' %></button><button data-review="returned" data-assignment-id="<%= item.id %>"><%= lang === 'zh' ? '退回修改' : 'Return for changes' %></button></div></article><% }); %></div><% if (!reviewQueue.length) { %><p><%= lang === 'zh' ? '暂无待审核证据。' : 'No evidence is awaiting review.' %></p><% } %></section>
<section class="quest-panel"><h2><%= lang === 'zh' ? '任务版本' : 'Quest versions' %></h2><div class="quest-table-wrap"><table><thead><tr><th>Slug</th><th><%= lang === 'zh' ? '版本' : 'Version' %></th><th><%= lang === 'zh' ? '状态' : 'State' %></th><th><%= lang === 'zh' ? '标题' : 'Title' %></th><th><%= lang === 'zh' ? '操作' : 'Action' %></th></tr></thead><tbody><% versions.forEach((item) => { %><tr><td><%= item.slug %></td><td><%= item.version %></td><td><%= item.lifecycle %></td><td><%= lang === 'zh' ? item.title_zh : item.title_en %></td><td><% if (['draft','validated'].includes(item.lifecycle)) { %><button data-publish-version="<%= item.id %>"><%= lang === 'zh' ? '发布冻结版本' : 'Publish frozen version' %></button><% } %></td></tr><% }); %></tbody></table></div></section><p id="quest-message" role="status" aria-live="polite"></p>
</main><%- include('partials/app-footer') %></div><script src="/js/i18n-helpers.js"></script><script src="/js/creator-shell.js"></script><script src="/js/creator-operation-center.js"></script><script src="/js/creator-responsive-navigation.js"></script><script src="/js/creator-context-help.js"></script><script src="/js/admin-quest-studio.js"></script><script src="/js/admin-workspace-experience.js"></script><script src="/js/creator-table-access.js"></script></body></html>
