<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f3f1eb">
    <title><%= lang === 'zh' ? '游戏目录 · Minimal Games' : 'Game Catalog · Minimal Games' %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="app-redesign page-games" data-authorized="<%= user && user.authorized ? 'true' : 'false' %>" data-username="<%= user ? user.username : '' %>">
    <%- include('partials/language-switcher') %>

    <div class="site-layout">
        <%- include('partials/site-header', { active: 'home' }) %>

        <main class="site-main">
            <section class="catalog-intro" aria-labelledby="games-title">
                <div>
                    <span class="eyebrow"><%= lang === 'zh' ? 'Minimal Games' : 'Minimal Games' %></span>
                    <h1 id="games-title"><%= lang === 'zh' ? '找一款合拍的游戏' : 'Find a game that fits' %></h1>
                    <p><%= lang === 'zh' ? '十款游戏，四种节奏。从短促的知识冲刺，到可以慢慢权衡的策略玩法，都在这里。' : 'Ten games across four moods, from quick knowledge sprints to slower strategic choices.' %></p>
                </div>
            </section>

            <% if (!(typeof user !== 'undefined' && user && user.authorized)) { %>
                <section class="access-banner <%= user ? 'pending' : '' %>" aria-labelledby="games-access-title">
                    <div>
                        <h2 id="games-access-title"><%= user ? (lang === 'zh' ? '账号尚未授权' : 'Account not yet approved') : (lang === 'zh' ? '先登录，再进入游戏' : 'Sign in before entering a game') %></h2>
                        <p><%= user ? (lang === 'zh' ? '授权完成后，本页所有入口会自动开放。' : 'Every entry unlocks automatically after approval.') : (lang === 'zh' ? '你仍可以先浏览完整游戏目录。' : 'You can still browse the full catalog below.') %></p>
                    </div>
                    <div class="access-actions">
                        <% if (user) { %>
                            <a href="/logout" class="secondary"><%= lang === 'zh' ? '退出账号' : 'Log out' %></a>
                        <% } else { %>
                            <a href="/login" class="secondary"><%= t.auth.login %></a>
                            <a href="/register"><%= t.auth.register %></a>
                        <% } %>
                    </div>
                </section>
            <% } %>

            <section class="catalog-section" aria-label="<%= lang === 'zh' ? '游戏目录' : 'Game catalog' %>">
                <div class="catalog-heading catalog-heading--compact">
                    <div class="catalog-filters" role="group" aria-label="<%= lang === 'zh' ? '筛选游戏类型' : 'Filter game category' %>">
                        <button type="button" class="active" data-catalog-filter="all" aria-pressed="true"><%= lang === 'zh' ? '全部 10' : 'All 10' %></button>
                        <button type="button" data-catalog-filter="brain" aria-pressed="false"><%= lang === 'zh' ? '益智' : 'Brain' %></button>
                        <button type="button" data-catalog-filter="chance" aria-pressed="false"><%= lang === 'zh' ? '运气' : 'Chance' %></button>
                        <button type="button" data-catalog-filter="strategy" aria-pressed="false"><%= lang === 'zh' ? '策略' : 'Strategy' %></button>
                        <button type="button" data-catalog-filter="challenge" aria-pressed="false"><%= lang === 'zh' ? '挑战' : 'Challenge' %></button>
                    </div>
                </div>

                <%- include('partials/game-catalog') %>
            </section>
        </main>

        <%- include('partials/app-footer') %>
    </div>

    <% if (typeof user !== 'undefined' && user && user.authorized) { %>
        <script src="/socket.io/socket.io.js"></script>
        <script src="/security-alerts.js"></script>
        <script src="/js/index.js"></script>
    <% } %>
</body>
</html>
