<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= lang === 'zh' ? '幸运祈愿' : 'Lucky Wish' %></title>
    <link rel="stylesheet" href="/styles.css">
    <style nonce="<%= cspNonce %>">
        .wish-modal-reward-name {
            margin: 15px 0;
            font-size: 2rem;
        }

        .wish-modal-reward-value {
            color: #f39c12;
            font-size: 1.5rem;
        }

        .wish-modal-reward-note {
            margin-top: 8px;
            color: #ccc;
            font-size: 1rem;
        }

        .wish-modal-guaranteed {
            margin-top: 10px;
            color: #e74c3c;
            font-size: 1rem;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem;
            background: rgba(0, 0, 0, 0.8);
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            color: #fff;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #00c853;
        }

        .header h1 {
            margin: 0;
            color: #00c853;
        }

        .nav-links {
            display: flex;
            gap: 1rem;
            align-items: center;
            color: #ccc;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .nav-links a:hover {
            background: rgba(0, 200, 83, 0.2);
            transform: translateY(-2px);
        }

        .wish-container {
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .balance-wish-section {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .balance-info {
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .balance-info h3 {
            color: #ffeb3b;
            margin: 0;
        }

        .gift-progress {
            margin-top: 1rem;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            overflow: hidden;
            height: 28px;
            position: relative;
        }

        .gift-progress-bar {
            width: 100%;
            height: 100%;
            appearance: none;
            border: 0;
            background: transparent;
            color: #eb655c;
            transition: color 0.3s ease;
            border-radius: 10px 0 0 10px;
        }

        .gift-progress-bar::-webkit-progress-bar {
            background: transparent;
        }

        .gift-progress-bar::-webkit-progress-value {
            background: #eb655c;
            transition: width 0.3s ease, background 0.3s ease;
        }

        .gift-progress-bar::-moz-progress-bar {
            background: #eb655c;
            transition: width 0.3s ease, background 0.3s ease;
        }

        .gift-progress-bar.is-near-guarantee::-webkit-progress-value {
            background: #c98708;
        }

        .gift-progress-bar.is-near-guarantee::-moz-progress-bar {
            background: #c98708;
        }

        .gift-progress-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #fff;
            font-weight: bold;
            font-size: 12px;
        }

        .wish-button {
            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 50px;
            color: white;
            padding: 20px 40px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 20px 0;
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }

        .wish-button:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: 0 15px 25px rgba(0,0,0,0.2);
        }

        .wish-button:disabled {
            background: #95a5a6;
            cursor: not-allowed;
            transform: none;
        }


        .probability-button {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ccc;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .probability-button:hover {
            background: rgba(0, 200, 83, 0.2);
            color: #fff;
        }

        /* 全屏弹窗样式 */
        .fullscreen-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0,0,0,0.9);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10000;
            animation: fadeIn 0.5s ease;
        }

        .modal-content {
            text-align: center;
            color: white;
            font-size: 4rem;
            font-weight: bold;
            text-shadow: 0 0 20px rgba(255,255,255,0.5);
            animation: pulse 2s infinite;
        }

        .modal-success {
            color: #00ff00;
            text-shadow: 0 0 30px #00ff00;
        }

        .modal-failure {
            color: #ff0000;
            text-shadow: 0 0 30px #ff0000;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* 飘屏样式 */
        .danmaku-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 8888;
            overflow: hidden;
        }

        .danmaku-message {
            position: absolute;
            white-space: nowrap;
            font-size: 16px;
            font-weight: bold;
            color: #FFD700;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
            background: linear-gradient(45deg, rgba(255,215,0,0.2), rgba(255,165,0,0.2));
            border: 2px solid rgba(255,215,0,0.6);
            padding: 8px 16px;
            border-radius: 20px;
            animation: danmaku-slide 12s linear;
            pointer-events: none;
            backdrop-filter: blur(2px);
        }

        .danmaku-lane-0 { top: 100px; }
        .danmaku-lane-1 { top: 150px; }
        .danmaku-lane-2 { top: 200px; }
        .danmaku-lane-3 { top: 250px; }
        .danmaku-lane-4 { top: 300px; }
        .danmaku-lane-5 { top: 350px; }
        .danmaku-lane-6 { top: 400px; }
        .danmaku-lane-7 { top: 450px; }
        .danmaku-lane-8 { top: 500px; }
        .danmaku-lane-9 { top: 550px; }
        .danmaku-lane-10 { top: 600px; }
        .danmaku-lane-11 { top: 650px; }
        .danmaku-lane-12 { top: 700px; }
        .danmaku-lane-13 { top: 750px; }
        .danmaku-lane-14 { top: 800px; }
        .danmaku-lane-15 { top: 850px; }
        .danmaku-lane-16 { top: 900px; }
        .danmaku-lane-17 { top: 950px; }
        .danmaku-lane-18 { top: 1000px; }
        .danmaku-lane-19 { top: 1050px; }


        @keyframes danmaku-slide {
            0% {
                transform: translateX(100vw);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translateX(-200px);
                opacity: 0;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }

            .header {
                flex-direction: column;
                gap: 1rem;
            }

            .modal-content {
                font-size: 2.5rem;
            }
            
            .wish-button {
                padding: 10px 16px;
                font-size: 12px;
                min-width: auto;
                flex: 1;
                max-width: 130px;
            }

            .danmaku-message {
                font-size: 14px;
                padding: 6px 12px;
            }
        }
        
        @media (max-width: 480px) {
            .wish-button {
                padding: 8px 12px;
                font-size: 11px;
                max-width: 110px;
            }
        }

        .wish-gift-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .gift-card {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            padding: 1.5rem;
            text-align: left;
        }

        .gift-card-large {
            grid-column: span 2;
            border: 2px solid rgba(0, 200, 83, 0.4);
            background: rgba(0, 200, 83, 0.08);
        }

        .gift-title {
            font-size: 1.4rem;
            color: #fff;
            margin-bottom: 0.5rem;
            font-weight: bold;
        }

        .gift-meta {
            color: #ccc;
            font-size: 0.9rem;
            margin-bottom: 0.8rem;
        }

        .gift-actions {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
        }

        .gift-action-btn {
            background: linear-gradient(135deg, #00c853, #00bfa5);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-weight: bold;
            padding: 0.6rem 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .gift-action-btn.secondary {
            background: linear-gradient(135deg, #1e88e5, #1565c0);
        }

        .gift-action-btn.test {
            background: linear-gradient(135deg, #8e44ad, #2c3e50);
        }

        .gift-action-btn:disabled {
            background: #95a5a6;
            cursor: not-allowed;
        }

        .wish-intro {
            color: #ccc;
        }

        .probability-actions {
            margin: 1rem 0;
            text-align: center;
        }

        .wish-disclaimer {
            max-width: 760px;
            margin: 2rem auto 0;
            padding: 1rem;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.05);
            color: #ccc;
            font-size: 0.85rem;
            line-height: 1.5;
            text-align: center;
        }

        .probability-modal-content {
            max-width: 680px;
            font-size: 1.2rem;
        }

        .probability-modal-title {
            margin-bottom: 1rem;
            font-size: 1.6rem;
        }

        .probability-list {
            text-align: left;
        }

        .probability-modal-actions {
            margin-top: 1rem;
        }

        @media (max-width: 768px) {
            .wish-gift-grid {
                grid-template-columns: 1fr;
            }

            .gift-card-large {
                grid-column: span 1;
            }
        }
    </style>
</head>
<body class="app-redesign game-page page-wish" data-csrf-token="<%= csrfToken %>" data-can-test="<%= canWishTest ? 'true' : 'false' %>" data-wish-configs="<%= encodeURIComponent(JSON.stringify(wishConfigs || {})) %>">
    <%- include('partials/language-switcher') %>

    <div class="container">
        <div class="header">
            <h1><%= lang === 'zh' ? '幸运祈愿' : 'Lucky Wish' %></h1>
            <div class="nav-links">
                <span><%= lang === 'zh' ? '用户' : 'User' %>：<%= username %></span>
                <a href="/">← <%= lang === 'zh' ? '游戏大厅' : 'Games' %></a>
                <a href="/profile"><%= lang === 'zh' ? '个人记录' : 'Activity' %></a>
            </div>
        </div>

        <div class="balance-wish-section">
            <div class="balance-info">
                <h3><%= lang === 'zh' ? '当前积分' : 'Current Points' %> <span id="current-balance"><%= balance || 0 %></span></h3>
            </div>
            <div class="wish-container">
                <p class="wish-intro">
                    <%= lang === 'zh'
                        ? '请选择礼物档位进行祈愿，成功后礼物进入背包。'
                        : 'Select a gift tier to make a wish. Successful gifts will enter your backpack.'
                    %>
                </p>
            </div>
        </div>
        
        <div class="wish-container">
            <div class="wish-gift-grid">
                <% Object.entries(wishConfigs || {}).forEach(([giftType, config], index) => { %>
                    <div class="gift-card <%= index === 0 ? 'gift-card-large' : '' %>" data-gift="<%= giftType %>">
                        <div class="gift-title"><%= lang === 'zh' ? config.nameZh : config.nameEn %></div>
                        <div class="gift-meta"><%= lang === 'zh'
                            ? `价值 ${config.rewardValue} 积分 · ${config.cost} 积分/次`
                            : `Value ${config.rewardValue} points · ${config.cost} points/draw`
                        %></div>
                        <div class="gift-actions">
                            <button class="gift-action-btn" data-gift="<%= giftType %>" data-count="1"><%= lang === 'zh' ? '抽一次' : 'Draw Once' %></button>
                            <button class="gift-action-btn secondary" data-gift="<%= giftType %>" data-count="10"><%= lang === 'zh' ? '十连' : '10x Draw' %></button>
                            <button class="gift-action-btn test admin-test-btn" data-gift="<%= giftType %>" hidden><%= lang === 'zh' ? '10万次测试' : '100k Test' %></button>
                        </div>
                        <div class="gift-progress">
                            <progress class="gift-progress-bar" data-progress-bar="<%= giftType %>" max="100" value="0"></progress>
                            <div class="gift-progress-text" data-progress-text="<%= giftType %>">0 / <%= config.guaranteeCount %></div>
                        </div>
                    </div>
                <% }); %>
            </div>
            
            <div class="probability-actions">
                <button class="probability-button" id="open-probability">
                    <%= lang === 'zh' ? '概率公示' : 'Odds Disclosure' %>
                </button>
            </div>


            <div class="wish-disclaimer">
                <% if (lang === 'zh') { %>
                    <strong>免责声明：</strong>本许愿功能仅供娱乐消遣，祈愿结果为随机娱乐内容，不涉及任何迷信或超自然因素。平台内所有积分、进度均为虚拟娱乐道具，无法兑换真实货币或有价物品。参与完全免费，符合相关法律法规。严禁未满18周岁用户使用，请理性娱乐。
                <% } else { %>
                    <strong>Disclaimer:</strong> This wishing feature is for entertainment only. Wish results are random entertainment content and do not involve any superstition or supernatural factors. All points and progress on the platform are virtual entertainment items that cannot be exchanged for real money or valuable goods. Participation is completely free and complies with relevant laws. Strictly prohibited for users under 18 years old. Please enjoy responsibly.
                <% } %>
            </div>
        </div>
    </div>

    
    <div id="danmaku-container" class="danmaku-container"></div>

    
    <div id="fullscreenModal" class="fullscreen-modal" hidden>
        <div id="modalContent" class="modal-content"></div>
    </div>

    
    <div id="probabilityModal" class="fullscreen-modal" hidden>
        <div class="modal-content probability-modal-content">
            <div class="probability-modal-title">
                <%= lang === 'zh' ? '概率公示' : 'Odds Disclosure' %>
            </div>
            <div id="probabilityList" class="probability-list"></div>
            <div class="probability-modal-actions">
                <button class="probability-button" id="close-probability">
                    <%= lang === 'zh' ? '关闭' : 'Close' %>
                </button>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/security-alerts.js"></script>
    <script src="/js/wish.js"></script>
</body>
</html>
