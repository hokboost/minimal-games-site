                    <div class="gift-actions">
                        <button class="gift-action-btn" data-gift="sky_throne" data-count="1"><%= lang === 'zh' ? '抽一次' : 'Draw Once' %></button>
                        <button class="gift-action-btn secondary" data-gift="sky_throne" data-count="10"><%= lang === 'zh' ? '十连' : '10x Draw' %></button>
                        <button class="gift-action-btn test admin-test-btn" data-gift="sky_throne" style="display: none;"><%= lang === 'zh' ? '10万次测试' : '100k Test' %></button>
                    </div>
                    <div class="gift-progress">
                        <div class="gift-progress-bar" data-progress-bar="sky_throne"></div>
                        <div class="gift-progress-text" data-progress-text="sky_throne">0 / 83</div>
                    </div>
                </div>

                <div class="gift-card" data-gift="proposal">
