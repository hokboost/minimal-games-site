<!DOCTYPE html>
<html lang="<%= lang === 'zh' ? 'zh-CN' : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/redesign.css">
    <link rel="stylesheet" href="/creator-rewards.css">
    <link rel="stylesheet" href="/creator-shell.css">
</head>
<body class="app-redesign reward-world" data-csrf-token="<%= csrfToken %>" data-lang="<%= lang %>">
    <%- include('partials/language-switcher') %>
    <div class="site-layout">
        <%- include('partials/site-header', { active: 'creator' }) %>
        <main class="reward-shell">
            <header class="reward-hero">
                <div><span><%= lang === 'zh' ? '可审计 · 可恢复' : 'Auditable · Recoverable' %></span>
                    <h1><%= title %></h1>
                    <p><%= lang === 'zh' ? '礼物权益领取后只进入现有背包；是否发送由你在背包中另行确认。' : 'Gift entitlements enter the existing backpack only. Sending remains a separate action you control there.' %></p>
                </div>
                <a href="/creator"><%= lang === 'zh' ? '返回主播世界' : 'Back to Creator World' %></a>
            </header>
            <section id="reward-catalog-panel" class="reward-panel">
                <h2><%= lang === 'zh' ? '奖励目录' : 'Reward catalog' %></h2>
                <div class="reward-grid">
                    <% catalog.items.forEach((item) => { %>
                        <article class="reward-card" data-catalog-version-id="<%= item.id %>" data-kind="<%= item.kind %>" data-points="<%= item.pointsPrice %>" data-eligibility="<%= item.eligible ? 'eligible' : 'locked' %>">
                            <small><%= item.kind %> · <%= item.pointsPrice %> points</small>
                            <h3><%= lang === 'zh' ? item.titleZh : item.titleEn %></h3>
                            <p><%= lang === 'zh' ? item.descriptionZh : item.descriptionEn %></p>
                            <p><%= lang === 'zh' ? '剩余库存' : 'Stock remaining' %>: <%= item.stockRemaining %></p>
                            <div class="reward-actions">
                                <button type="button" data-reward-action="create" <%= item.eligible ? '' : 'disabled' %>><%= item.requiresApproval ? (lang === 'zh' ? '提交审批' : 'Request approval') : (lang === 'zh' ? '兑换' : 'Redeem') %></button>
                                <button type="button" data-reward-action="wishlist"><%= lang === 'zh' ? '加入心愿' : 'Add to wishlist' %></button>
                            </div>
                            <% if (!item.eligible) { %><small><%= item.reasonCode %></small><% } %>
                        </article>
                    <% }); %>
                </div>
            </section>
            <section id="reward-order-panel" class="reward-panel">
                <h2><%= lang === 'zh' ? '订单与交付状态' : 'Orders and delivery state' %></h2>
                <div id="reward-orders" class="reward-grid">
                    <% state.orders.forEach((order) => { %>
                        <article class="reward-card" data-order-id="<%= order.id %>" data-status="<%= order.status %>">
                            <h3><%= lang === 'zh' ? order.titleZh : order.titleEn %></h3>
                            <p><%= order.status %><% if (order.inventoryStatus) { %> · backpack: <%= order.inventoryStatus %><% } %><% if (order.deliveryStatus) { %> · delivery: <%= order.deliveryStatus %><% } %></p>
                            <% if (order.needsReconciliation) { %><p class="reward-warning"><%= lang === 'zh' ? '交付结果不确定，正在对账；系统不会自动补发或退回。' : 'Delivery is uncertain and awaiting reconciliation. It will not be resent or refunded automatically.' %></p><% } %>
                            <% if (order.status === 'approved') { %><button type="button" data-reward-action="claim"><%= lang === 'zh' ? '领取' : 'Claim' %></button><% } %>
                            <% if (order.status === 'pending_approval') { %><button type="button" data-reward-action="cancel"><%= lang === 'zh' ? '取消申请' : 'Cancel request' %></button><% } %>
                            <% if (order.inventoryStatus === 'stored') { %><a href="/#wish-backpack"><%= lang === 'zh' ? '前往背包确认发送' : 'Open backpack to send' %></a><% } %>
                        </article>
                    <% }); %>
                </div>
            </section>
            <section class="reward-panel"><h2><%= lang === 'zh' ? '已收藏资产' : 'Owned assets' %></h2>
                <ul><% state.assets.forEach((asset) => { %><li><%= asset.type %> · <%= asset.key %></li><% }); %></ul>
            </section>
            <section class="reward-panel"><h2><%= lang === 'zh' ? '心愿目标' : 'Wishlist goals' %></h2>
                <ul><% state.wishlist.forEach((goal) => { %><li><%= lang === 'zh' ? goal.titleZh : goal.titleEn %> · <%= lang === 'zh' ? '目标' : 'target' %> <%= goal.targetQuantity %> · P<%= goal.priority %></li><% }); %></ul>
                <% if (!state.wishlist.length) { %><p><%= lang === 'zh' ? '还没有心愿目标。' : 'No wishlist goals yet.' %></p><% } %>
            </section>
            <p id="reward-message" role="status" aria-live="polite"></p>
        </main>
        <%- include('partials/app-footer') %>
    </div>
    <script src="/js/i18n-helpers.js"></script>
    <script src="/js/creator-shell.js"></script>
    <script src="/js/creator-operation-center.js"></script>
    <script src="/js/creator-responsive-navigation.js"></script>
    <script src="/js/creator-context-help.js"></script>
    <script src="/js/creator-explorer.js"></script>
    <script src="/js/creator-rewards.js"></script>
    <script src="/js/reward-collection-experience.js"></script>
</body>
</html>
